# CodeSwarm Service — Environment Variables

# === Database ===
DATABASE_URL=postgresql://codeswarm:codeswarm_dev@localhost:5432/codeswarm

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Scheduler ===
PORT=8080
JWT_SECRET=change-me-in-production
WORKSPACE_BASE_PATH=/mnt/workspace
TASK_CLEANUP_RETENTION_DAYS=30
LOG_LEVEL=info

# === Worker ===
NODE_ID=worker-1
MAX_CONCURRENT=3
SCHEDULER_URL=http://localhost:8080
WORKER_ADDRESS=localhost:8080
TASK_TIMEOUT_SEC=86400
GRACEFUL_SHUTDOWN_TIMEOUT_MS=300000

# === MinIO (可选) ===
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=codeswarm
MINIO_USE_SSL=false

AIGW_WORK_KEYS_URL=http://secflow.ai.icsl.huawei.com
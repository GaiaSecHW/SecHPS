# 数据库配置
DATABASE_URL="postgresql://postgres:Huawei12%23%24@172.31.23.182:5432/copy?connection_limit=20&pool_timeout=60&connect_timeout=10&socket_timeout=60&statement_timeout=60000"
JWT_SECRET="your-secret-key-change-in-production"
NODE_ENV="development"

# CodeSwarm Worker 回调地址（主服务器侧配置，Worker 侧见 codeswarm/.env）
NEXT_PUBLIC_BASE_URL="http://172.31.31.203:3000"

# Claude SDK MCP 超时配置（毫秒）- 10 分钟
CLAUDE_CODE_STREAM_CLOSE_TIMEOUT=600000

# CodeSwarm 任务执行超时（秒）- 默认 7天 (7*24*3600=604800)，可通过此变量调整
TASK_TIMEOUT_SEC=604800


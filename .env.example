# AI4WEB 平台环境变量配置

# 数据库配置（SQLite）
# DATABASE_URL="file:./prisma/prod.db"
# 数据库配置（postgresql）
DATABASE_URL="postgresql://postgres:Huawei12%23%24@172.31.23.182:5432/ai4sec"
# ============================================
# JWT 密钥（必须设置！）
# ============================================
# ⚠️  重要: 应用启动时会检查此变量，未设置将拒绝启动
#
# 生成安全密钥的方法:
# 1. Node.js:    node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 2. OpenSSL:    openssl rand -hex 64
# 3. 在线工具:   https://generate-secret.vercel.app/64
#
# ⚠️  安全提示:
# - 请勿使用默认值或示例值
# - 请勿将此文件提交到版本控制
# - 生产环境必须使用强随机密钥（至少64字符）
# ============================================
JWT_SECRET=""

# 服务端口（默认 3000）
PORT="3000"

# 注意: NODE_ENV 由 Next.js 自动管理，无需手动设置
# - 开发环境: next dev 自动设置为 development
# - 生产环境: next build/start 自动设置为 production

# ============================================
# SFTP 配置（可选）
# ============================================
# 用于任务实例上传文件到远程服务器
# SFTP_HOST="172.31.30.81"
# SFTP_PORT="22"
# SFTP_USER="username"
# SFTP_PASSWORD="password"
# SFTP_REMOTE_PATH="/home/user/Shared-workspace"

# ============================================
# 路径映射配置（可选）
# ============================================
# Windows 本地调试时，将远程 Linux 路径映射到本地挂载路径
# 需要先通过 SSHFS 挂载远程目录到本地驱动器
# 格式: "远程路径前缀=本地路径前缀"
# PATH_MAPPING="/home/user=P:"
# 这样 /home/user/Shared-workspace/task123 会转换为 P:/Shared-workspace/task123

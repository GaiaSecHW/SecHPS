# MinIO 配置（主服务器和 Worker 共享连接，各自指定 bucket）
# 主服务器用此连接访问 knowledge-graph 缓存和漏洞文件存储
# Worker 的 codedmap DB 缓存也使用此 MinIO 实例
MINIO_ENDPOINT="172.31.23.181"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_USE_SSL="false"

# MinIO bucket - 知识图谱缓存（主服务器 knowledge-graph API 读取）
MINIO_BUCKET="codedmap-dbs"

# MinIO bucket - 漏洞文件存储（统一存储报告和原始文件）
MINIO_VULN_FILE_BUCKET="vuln-file"
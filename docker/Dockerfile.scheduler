# docker/Dockerfile.scheduler
FROM node:20-bookworm AS builder

WORKDIR /app
RUN npm install -g pnpm@9

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/types/package.json ./packages/types/
COPY packages/scheduler/package.json ./packages/scheduler/
COPY prisma/ ./prisma/

RUN pnpm install --no-frozen-lockfile

COPY packages/types/ ./packages/types/
COPY packages/scheduler/ ./packages/scheduler/
COPY tsconfig.json ./

RUN pnpm --filter @codeswarm/types build
RUN pnpm --filter @codeswarm/scheduler build
RUN npx prisma generate --schema=prisma/schema.prisma

# 生成含所有生产依赖的独立目录（解决 workspace symlink 问题）
RUN pnpm --filter @codeswarm/scheduler deploy --prod /deploy
RUN cp -r node_modules/.prisma /deploy/node_modules/.prisma

FROM node:20-bookworm-slim

WORKDIR /app
COPY --from=builder /deploy ./
COPY --from=builder /app/prisma ./prisma

EXPOSE 8080
CMD ["node", "dist/index.js"]

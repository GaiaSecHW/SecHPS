# docker/Dockerfile.scheduler
FROM node:20-bookworm AS builder

WORKDIR /app
RUN npm install -g pnpm@9

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/types/package.json ./packages/types/
COPY packages/scheduler/package.json ./packages/scheduler/
COPY prisma/ ./prisma/

RUN pnpm install --no-frozen-lockfile

COPY packages/types/ ./packages/types/
COPY packages/scheduler/ ./packages/scheduler/
COPY tsconfig.json ./

RUN pnpm --filter @codeswarm/types build
RUN pnpm --filter @codeswarm/scheduler build

# 生成含所有生产依赖的独立目录
RUN pnpm --filter @codeswarm/scheduler deploy --prod /deploy

# 在 deploy 目录内生成 Prisma Client（避免 workspace 路径问题）
RUN cp -r prisma /deploy/prisma && \
    cd /deploy && npx --yes prisma@6 generate --schema=prisma/schema.prisma

FROM node:20-bookworm-slim

WORKDIR /app
COPY --from=builder /deploy ./

EXPOSE 8080
CMD ["node", "dist/index.js"]

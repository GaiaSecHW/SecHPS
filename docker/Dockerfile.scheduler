# ============================================================================
# Chimera Scheduler - Multi-stage Docker Build (Fully Self-Contained)
#
# Build context: project root
#   docker build -f docker/Dockerfile.scheduler -t Chimera-scheduler:latest .
#
# 特点:
#   - 完全自包含：适用于无外网隔离部署环境
#   - 基于 Debian Trixie (glibc 2.38+)，与 Worker 保持一致的基础镜像
#   - pnpm monorepo 构建，生产部署裁剪（pnpm deploy）
#   - Prisma Client 预生成，运行阶段不访问外网
#   - Scheduler 不含 Worker 专用工具（JDK/Joern/codedmap/AI CLI）
#
# Runtime env vars:
#   PORT                - Scheduler HTTP port (default 8080)
#   DATABASE_URL        - PostgreSQL connection string
#   REDIS_URL           - Redis connection string
#   JWT_SECRET          - JWT signing secret
#   WORKSPACE_BASE_PATH - Shared workspace path (default /mnt/workspace)
#   TASK_CLEANUP_RETENTION_DAYS - Task cleanup retention (default 30)
#   LOG_LEVEL           - Log level (default info)
#
# Important:
#   - Prisma Client 必须在 builder 阶段生成并拷入 deployment
#   - Runtime 阶段所有软件从 builder 阶段 COPY，不执行任何外网下载
# ============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Build codeswarm scheduler (Node.js pnpm monorepo)
# ---------------------------------------------------------------------------
FROM node:20-trixie AS scheduler-builder

WORKDIR /build/codeswarm

RUN npm config set registry https://registry.npmmirror.com

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.json ./

COPY packages/types/package.json ./packages/types/package.json
COPY packages/scheduler/package.json ./packages/scheduler/package.json
COPY packages/debug-ui/package.json ./packages/debug-ui/package.json
COPY prisma/ ./prisma/

RUN pnpm install --no-frozen-lockfile

COPY packages/types/ ./packages/types/
COPY packages/scheduler/ ./packages/scheduler/
COPY packages/debug-ui/ ./packages/debug-ui/

RUN pnpm --filter @codeswarm/types build && \
    pnpm --filter @codeswarm/scheduler build && \
    pnpm --filter @codeswarm/debug-ui build

# Generate Prisma Client
RUN npx prisma generate --schema=prisma/schema.prisma && \
    echo "=== Prisma Client generated OK ==="

# Create pruned deployment
RUN pnpm deploy --prod --filter @codeswarm/scheduler /deploy/scheduler && \
    echo "=== Scheduler deployment created ===" && \
    ls /deploy/scheduler/dist/ && \
    ls /deploy/scheduler/node_modules/ | head -10

# ---------------------------------------------------------------------------
# Copy Prisma generated client into deployment directory
# pnpm deploy includes @prisma/client but the generated native engines
# (.prisma/client) live in the pnpm virtual store (node_modules/.pnpm/...).
# Prisma Client runtime resolves .prisma/client from within its own pnpm
# scope, so we must copy into BOTH:
#   1. The top-level node_modules/.prisma/client (for some resolution paths)
#   2. The pnpm virtual store @prisma/client scope (the primary resolution path)
# ---------------------------------------------------------------------------
RUN PRISMA_CLIENT_SRC=$(find /build/codeswarm/node_modules/.pnpm -path '*/.prisma/client' -type d | head -1) && \
    if [ -z "$PRISMA_CLIENT_SRC" ]; then \
      echo "❌ FATAL: .prisma/client not found in build pnpm store" && exit 1; \
    fi && \
    echo "Found Prisma Client source at: $PRISMA_CLIENT_SRC" && \
    \
    # --- Copy to top-level node_modules/.prisma/client --- \
    mkdir -p /deploy/scheduler/node_modules/.prisma/client && \
    cp -r "$PRISMA_CLIENT_SRC"/* /deploy/scheduler/node_modules/.prisma/client/ && \
    echo "✅ Copied to top-level .prisma/client" && \
    \
    # --- Copy to pnpm virtual store inside deployment --- \
    DEPLOY_PRISMA_SCOPE=$(find /deploy/scheduler/node_modules/.pnpm -path '*@prisma+client*/node_modules' -maxdepth 4 -type d | head -1) && \
    if [ -n "$DEPLOY_PRISMA_SCOPE" ]; then \
      mkdir -p "$DEPLOY_PRISMA_SCOPE/.prisma/client" && \
      cp -r "$PRISMA_CLIENT_SRC"/* "$DEPLOY_PRISMA_SCOPE/.prisma/client/" && \
      echo "✅ Copied to pnpm store: $DEPLOY_PRISMA_SCOPE/.prisma/client"; \
    else \
      echo "⚠️ No @prisma/client scope found in deployment pnpm store (top-level copy may suffice)"; \
    fi && \
    echo "=== Prisma client copied to deployment ==="

# Copy Prisma schema to deployment (needed for runtime migrations)
RUN mkdir -p /deploy/scheduler/prisma && \
    cp /build/codeswarm/prisma/schema.prisma /deploy/scheduler/prisma/schema.prisma && \
    echo "=== Prisma schema copied to deployment ==="

# ---------------------------------------------------------------------------
# Stage 2: Production Runtime
# ---------------------------------------------------------------------------
# Scheduler 是纯 Node.js HTTP 服务，不含 Worker 专用重型工具。
# 使用 node:20-trixie 与 Worker 保持一致基础镜像，简化运维环境。
FROM node:20-trixie AS runtime

WORKDIR /opt/scheduler

# ---------------------------------------------------------------------------
# Install runtime tools
# Scheduler is a lightweight HTTP service — only basic networking & debugging tools.
# ---------------------------------------------------------------------------
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        # -- networking essentials --
        curl \
        ca-certificates \
        dnsutils \
        # -- re-declared from base (for clarity) --
        git \
        bash \
        procps \
        # -- debugging & diagnostics --
        jq \
        strace \
        lsof \
        tcpdump \
        htop \
        net-tools \
        iputils-ping \
        netcat-openbsd \
        # -- editing & file inspection --
        vim \
        tree \
        less \
        wget \
    && rm -rf /var/lib/apt/lists/* \
    && echo 'alias ll="ls -laF --color=auto"' >> /etc/bash.bashrc

# ---------------------------------------------------------------------------
# Copy pruned scheduler deployment (from builder stage — no symlinks)
# ---------------------------------------------------------------------------
COPY --from=scheduler-builder /deploy/scheduler /opt/scheduler

# ---------------------------------------------------------------------------
# Copy Debug UI build output (served at /debug/* by Fastify static)
# server.ts resolves: path.join(__dirname, '../../debug-ui/dist')
# __dirname = /opt/scheduler/dist → ../../debug-ui/dist = /opt/debug-ui/dist
# ---------------------------------------------------------------------------
COPY --from=scheduler-builder /build/codeswarm/packages/debug-ui/dist /opt/debug-ui/dist

# ---------------------------------------------------------------------------
# Verify ALL critical components (fail build if any missing)
# ---------------------------------------------------------------------------
RUN echo "=== Verifying critical scheduler components ===" && \
    \
    echo "1. Node.js..." && \
    node --version && echo "   ✅ Node.js" && \
    \
    echo "2. Scheduler entry..." && \
    test -f /opt/scheduler/dist/index.js && echo "   ✅ dist/index.js" || (echo "   ❌ MISSING" && exit 1) && \
    \
    echo "3. Fastify..." && \
    test -d /opt/scheduler/node_modules/fastify && echo "   ✅ fastify" || (echo "   ❌ MISSING" && exit 1) && \
    \
    echo "4. ioredis..." && \
    test -d /opt/scheduler/node_modules/ioredis && echo "   ✅ ioredis" || (echo "   ❌ MISSING" && exit 1) && \
    \
    echo "5. Prisma Client..." && \
    test -d /opt/scheduler/node_modules/.prisma/client && echo "   ✅ .prisma/client" || (echo "   ❌ MISSING: .prisma/client" && exit 1) && \
    test -d /opt/scheduler/node_modules/@prisma/client && echo "   ✅ @prisma/client" || (echo "   ❌ MISSING: @prisma/client" && exit 1) && \
    \
    echo "6. Prisma schema..." && \
    test -f /opt/scheduler/prisma/schema.prisma && echo "   ✅ schema.prisma" || (echo "   ❌ MISSING: schema.prisma" && exit 1) && \
    \
    echo "7. glibc version..." && \
    ldd --version 2>&1 | head -1 && echo "   ✅ glibc >= 2.38" && \
    \
    echo "8. Debug UI..." && \
    test -f /opt/debug-ui/dist/index.html && echo "   ✅ debug-ui/index.html" || (echo "   ❌ MISSING: debug-ui" && exit 1) && \
    \
    echo "9. Basic tools..." && \
    which curl && echo "   ✅ curl" && \
    which jq && echo "   ✅ jq" && \
    which vim && echo "   ✅ vim" && \
    which dig && echo "   ✅ dnsutils (dig)" && \
    \
    echo "=== All critical components verified OK ==="

# ---------------------------------------------------------------------------
# Runtime environment
# ---------------------------------------------------------------------------
ENV PORT=8080 \
    DATABASE_URL="postgresql://codeswarm:codeswarm_dev@localhost:5432/codeswarm" \
    REDIS_URL="redis://localhost:6379" \
    JWT_SECRET="dev-jwt-secret-change-in-production" \
    WORKSPACE_BASE_PATH="/mnt/workspace"

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["node", "dist/index.js"]

{
  "name": "SecHPS-test-platform",
  "version": "1.0.0",
  "description": "SecHPS 测试平台 - AI-powered coding assistant platform with role-based access control",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build && node scripts/postbuild.js",
    "start": "node --env-file=.env .next/standalone/server.js",
    "lint": "next lint",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-techstack": "tsx prisma/seed-techstack.ts",
    "db:seed-agents": "tsx prisma/seed-agent-definitions.ts",
    "db:seed-fsm": "tsx prisma/seed-fsm-templates.ts",
    "db:seed-attack-pattern": "tsx prisma/seed-attack-pattern.ts",
    "migrate:workflow-to-agent-team": "tsx scripts/migrate-workflow-to-agent-team.ts",
    "rollback:agent-team": "tsx scripts/rollback-agent-team-migration.ts",
    "clean": "rmdir /s .next &&  rmdir /s node_modules && del package-lock.json && npm install",
    "f-build": "rmdir /s  .next && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.101",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/typography": "^0.5.19",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.2",
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.5.16",
    "ansi-to-html": "^0.7.2",
    "archiver": "^7.0.1",
    "async-lock": "^1.4.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.0",
    "eventsource": "^3.0.7",
    "fastify": "^5.4.0",
    "html-to-image": "^1.11.13",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "minio": "^8.0.7",
    "next": "^16.2.9",
    "node-pty": "^1.1.0",
    "prisma": "^6.19.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^9.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.36.0",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "tar": "^7.5.15",
    "undici": "^7.10.0",
    "ws": "^8.20.0",
    "yaml": "^2.8.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/async-lock": "^1.4.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/eventsource": "^1.1.15",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/minio": "^7.1.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ssh2": "^1.15.5",
    "@types/tar": "^6.1.13",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tsx": "^4.21.0",
    "typescript": "6.0.2",
    "vitest": "^4.1.4"
  }
}

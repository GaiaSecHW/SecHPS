// Skill-漏洞关联表：记录哪个 Skill 发现了哪个漏洞
model SkillVulnerabilityMapping {
  id                String   @id @default(cuid())
  skillId           String // Skill ID（匹配后）
  vulnerabilityId   String // Vulnerability ID
  evaluationId      String // 评估会话 ID
  projectId         String // 项目 ID
  skillNameReported String? // AI 报告的原始 Skill 名称（vulnerabilities.json 中的 skill 字段）
  matchType         String   @default("exact") // exact | fuzzy | unmatched
  matchedAt         DateTime @default(now())

  Skill             Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)
  Vulnerability     Vulnerability     @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  EvaluationSession EvaluationSession @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  Project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([skillId, vulnerabilityId])
  @@index([skillId])
  @@index([vulnerabilityId])
  @@index([evaluationId])
  @@index([projectId])
  @@index([matchType])
}

// ============================================
// FSM 工作流模板
// ============================================
model FSMTemplate {
  id           String   @id @default(cuid())
  name         String   @unique // "threat-modeling" | "code-audit"
  displayName  String
  description  String?
  nodeCount    Int // 固定节点数量
  nodes        String // JSON: 节点定义 [{id, label, phase, skillPath, ...}]
  agentZone    String? // JSON: Agent 区配置 {position, allowAdd, parallel, defaultAgents}
  skillPath    String? // Skill 目录路径: "skills/threat-modeling"
  version      String   @default("1.0.0")
  isActive     Boolean  @default(true)
  isBuiltin    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  Workflow Workflow[]

  @@index([name])
  @@index([isActive])
  @@index([isBuiltin])
}

// ============================================
// 阶段输出 (FSM 专用)
// ============================================
model PhaseOutput {
  id          String  @id @default(cuid())
  sessionId   String // 关联 EvaluationSession
  executionId String? // 关联 WorkflowExecution (可选)
  nodeId      String? // 关联 WorkflowNode (可选)

  // 阶段信息
  phaseNumber Int // 1-4
  phaseName   String // "system-understanding" | "security-assessment" | ...
  phases      String? // JSON: ["P1", "P2"]

  // 输出数据
  outputYaml String // YAML 内容 (结构化数据)
  outputPath String // 文件路径: .claude/phases/1-.../P1.yaml

  // 验证状态
  status       String    @default("pending") // "pending" | "validated" | "failed"
  validatedAt  DateTime?
  errorMessage String?

  // 统计
  findingsCount Int? @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  EvaluationSession EvaluationSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  WorkflowExecution WorkflowExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([executionId])
  @@index([phaseNumber])
  @@index([status])
}

// ============================================
// 报告模型 (统一重构)
// ============================================
model Report {
  id        String @id @default(cuid())
  sessionId String @unique // 关联 EvaluationSession (一对一)
  projectId String

  // 报告类型
  reportType   String // "dag" | "fsm" | "analysis" | "scan"
  workflowType String? // "dag" | "fsm"
  fsmTemplate  String? // FSM 模板名称: "threat-modeling"

  // 报告元数据
  title       String
  description String?

  // 主报告
  mainReportPath    String? // 文件路径: .claude/reports/xxx/MAIN.md
  mainReportContent String? // 或直接存储内容 (小报告)

  // 子报告列表
  subReports String? // JSON: [{filename, title, path}]

  // 统计信息
  totalFindings Int @default(0)
  criticalCount Int @default(0)
  highCount     Int @default(0)
  mediumCount   Int @default(0)
  lowCount      Int @default(0)
  infoCount     Int @default(0)

  // 数据来源追踪
  dataSources String? // JSON: {phaseOutputs: [], agentResults: [], workspaceReports: []}

  // 集成的外部报告
  integratedReports String? // JSON: [{source, type, findingsCount}]

  // 原始数据 (兼容旧字段)
  rawContent String? // 大模型原始输出
  skillsUsed String? // JSON: [{skillId, skillName}]

  // 状态
  status String @default("generated") // "generating" | "generated" | "failed"

  // 时间
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  EvaluationSession EvaluationSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  Project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ReportSection     ReportSection[]
  IntegratedReport  IntegratedReport[]

  @@index([sessionId])
  @@index([projectId])
  @@index([reportType])
  @@index([workflowType])
  @@index([status])
}

// ============================================
// 报告章节 (细粒度存储)
// ============================================
model ReportSection {
  id       String @id @default(cuid())
  reportId String

  sectionId String // "section-0" | "section-1" | ... | "appendix-a"
  title     String
  order     Int

  // 内容存储
  contentPath String? // 文件路径
  content     String? // 或直接存储

  // 元数据
  metadata String? // JSON: {findingsCount, type}

  createdAt DateTime @default(now())

  Report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, sectionId])
  @@index([reportId])
  @@index([order])
}

// ============================================
// 外部报告集成
// ============================================
model IntegratedReport {
  id       String @id @default(cuid())
  reportId String

  // 来源信息
  sourcePath String // "vulnerabilities/sast-report.json"
  sourceType String // "sast" | "secret" | "dependency" | "owasp-zap" | "burp" | "manual"
  format     String // "json" | "html" | "xml" | "md"

  // 解析结果
  title         String?
  summary       String?
  findingsCount Int     @default(0)
  findings      String? // JSON: 提取的漏洞列表

  // 原始内容
  rawContent String? // 原始文件内容

  createdAt DateTime @default(now())

  Report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([sourceType])
}

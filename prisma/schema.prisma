  fsmOrder                                         Int?
  fsmPhase                                         Int?
  skillPath                                        String?
  WorkflowEdge_WorkflowEdge_sourceIdToWorkflowNode WorkflowEdge[] @relation("WorkflowEdge_sourceIdToWorkflowNode")
  WorkflowEdge_WorkflowEdge_targetIdToWorkflowNode WorkflowEdge[] @relation("WorkflowEdge_targetIdToWorkflowNode")
  Workflow                                         Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  WorkflowRole                                     WorkflowRole?  @relation(fields: [roleId], references: [id])

  @@index([fsmOrder])
  @@index([fsmPhase])
  @@index([roleId])
  @@index([workflowId])
  @@index([type])
}

model WorkflowRole {
  id           String         @id
  workflowId   String
  name         String
  description  String?
  color        String?
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  WorkflowNode WorkflowNode[]
  Workflow     Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model WorkflowShare {
  id                                  String    @id
  workflowId                          String
  sharedBy                            String
  sharedWith                          String
  permission                          String    @default("read")
  expiresAt                           DateTime?
  createdAt                           DateTime  @default(now())
  Workflow                            Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  User_WorkflowShare_sharedByToUser   User      @relation("WorkflowShare_sharedByToUser", fields: [sharedBy], references: [id], onDelete: Cascade)
  User_WorkflowShare_sharedWithToUser User      @relation("WorkflowShare_sharedWithToUser", fields: [sharedWith], references: [id], onDelete: Cascade)

  @@unique([workflowId, sharedWith])
  @@index([workflowId])
  @@index([sharedBy])
  @@index([sharedWith])
}

model TaskInstance {
  id               String             @id
  userId           String?
  name             String
  agentId          String
  agentName        String
  modelId          String?
  modelName        String?
  parameters       String
  filePath         String?
  projectPath      String?
  skills           String?
  scripts          String?
  notes            String?
  status           String             @default("pending")
  startedAt        DateTime?
  completedAt      DateTime?
  errorMessage     String?
  mergedSkills     String?
  mergedScripts    String?
  executionResult  String?
  reportPath       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  User             User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ModelConfig      ModelConfig?       @relation(fields: [modelId], references: [id], onDelete: SetNull)
  TaskExecutionLog TaskExecutionLog[]

  @@index([userId])
  @@index([status])
  @@index([agentId])
  @@index([modelId])
  @@index([createdAt])
}

model TaskExecutionLog {
  id           String       @id
  taskId       String
  timestamp    DateTime     @default(now())
  level        String
  message      String
  details      String?
  createdAt    DateTime     @default(now())
  TaskInstance TaskInstance @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([level])
  @@index([timestamp])
}

model CodeswarmWorker {
  id            String    @id @default(cuid())
  nodeId        String    @unique
  address       String
  status        String    @default("online")
  maxConcurrent Int       @default(5)
  currentTasks  Int       @default(0)
  lastHeartbeat DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  CodeswarmTask CodeswarmTask[]
}

model CodeswarmTask {
  id              String          @id @default(cuid())
  taskId          String          @unique
  workerId        String?
  state           String          @default("queued")
  instruction     String
  projectPath     String?
  workspacePath   String?
  gitUrl          String?
  gitRef          String?
  skills          String?
  mcps            String?
  model           String?
  apiKey          String?
  timeoutSec      Int?
  agent           String?
  events          String?
  result          String?
  error           String?
  reportContent   String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  CodeswarmWorker CodeswarmWorker? @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([state])
  @@index([workerId])
  @@index([createdAt])
}

model AgentApp {
  id           String   @id
  userId       String
  name         String
  engine       String
  skillPath    String
  startCommand String
  notes        String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AgentDefinition {
  id              String            @id
  userId          String?
  name            String            @unique
  displayName     String
  description     String?
  category        String
  modelConfigId   String?
  model           String
  systemPrompt    String?
  allowedTools    String?
  skills          String?
  isActive        Boolean           @default(true)
  isBuiltin       Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  User            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ModelConfig     ModelConfig?      @relation(fields: [modelConfigId], references: [id])
  AgentTeam       AgentTeam[]
  AgentTeamMember AgentTeamMember[]

  @@index([name])
  @@index([category])
  @@index([isActive])
}

model AgentMemberExecution {
  id                 String             @id
  teamExecutionId    String
  memberId           String
  status             String             @default("pending")
  startedAt          DateTime?
  completedAt        DateTime?
  inputTokens        Int                @default(0)
  outputTokens       Int                @default(0)
  createdAt          DateTime           @default(now())
  AgentTeamExecution AgentTeamExecution @relation(fields: [teamExecutionId], references: [id], onDelete: Cascade)
  AgentTeamMember    AgentTeamMember    @relation(fields: [memberId], references: [id])

  @@index([teamExecutionId])
  @@index([memberId])
  @@index([status])
}

model AgentTeam {
  id                 String               @id
  userId             String
  name               String
  description        String?
  leadAgentId        String
  taskStrategy       String?              @default("parallel")
  maxTeammates       Int                  @default(5)
  status             String               @default("idle")
  ralphConfig        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  User               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  AgentDefinition    AgentDefinition      @relation(fields: [leadAgentId], references: [id], onDelete: Cascade)
  AgentTeamExecution AgentTeamExecution[]
  AgentTeamMember    AgentTeamMember[]
  EvaluationSession  EvaluationSession[]

  @@index([userId])
  @@index([status])
  @@index([leadAgentId])
}

model AgentTeamExecution {
  id                   String                 @id
  teamId               String
  evaluationId         String?
  status               String                 @default("pending")
  startedAt            DateTime?
  completedAt          DateTime?
  totalInputTokens     Int                    @default(0)
  totalOutputTokens    Int                    @default(0)
  createdAt            DateTime               @default(now())
  AgentMemberExecution AgentMemberExecution[]
  AgentTeam            AgentTeam              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  EvaluationSession    EvaluationSession?     @relation(fields: [evaluationId], references: [id])

  @@index([teamId])
  @@index([evaluationId])
  @@index([status])
}

model AgentTeamMember {
  id                   String                 @id
  teamId               String
  agentId              String
  role                 String
  overrideModel        String?
  overrideTools        String?
  createdAt            DateTime               @default(now())
  AgentMemberExecution AgentMemberExecution[]
  AgentTeam            AgentTeam              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  AgentDefinition      AgentDefinition        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([agentId])
}

model AlertInstance {
  id               String    @id
  ruleId           String
  ruleName         String
  severity         String
  status           String    @default("active")
  message          String
  value            Float
  threshold        Float
  triggeredAt      DateTime  @default(now())
  resolvedAt       DateTime?
  acknowledgedAt   DateTime?
  acknowledgedBy   String?
  details          String?
  notifiedChannels String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  AlertRule        AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([triggeredAt])
  @@index([severity])
  @@index([status])
  @@index([ruleId])
}

model AlertRule {
  id                   String          @id
  name                 String          @unique
  description          String?
  metricType           String
  condition            String
  severity             String          @default("medium")
  enabled              Boolean         @default(true)
  cooldownPeriod       Int             @default(300)
  notificationChannels String
  tags                 String?
  lastTriggeredAt      DateTime?
  triggerCount         Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime
  AlertInstance        AlertInstance[]

  @@index([severity])
  @@index([enabled])
  @@index([metricType])
}

model AnalysisReport {
  id                  String            @id
  evaluationId        String            @unique
  projectId           String
  projectName         String
  description         String
  techStack           String?
  projectType         String?
  frontend            String?
  backend             String?
  database            String?
  directoryStructure  String?
  architectureSummary String?
  apiEndpoints        String?
  pageEntries         String?
  userInputPoints     String?
  entryPointsSummary  String?
  authType            String?
  tokenStorage        String?
  tokenExpiry         String?
  refreshMechanism    String?
  authzModel          String?
  roles               String?
  sessionManagement   String?
  securityConfig      String?
  authSummary         String?
  analyzedAt          DateTime?
  rawContent          String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime
  Project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  EvaluationSession   EvaluationSession @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([projectId])
  @@index([evaluationId])
}

model AuditLog {
  id        String   @id
  userId    String?
  action    String
  resource  String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([createdAt])
  @@index([action])
  @@index([userId])
}

model AutonomousEvolutionExperience {
  id              String    @id
  title           String
  errorCategory   String
  errorPatterns   String
  sourceModel     String
  sourceSessionId String
  sourceProjectId String?
  attemptSequence String
  directSolution  String
  lesson          String
  isInjected      Boolean   @default(false)
  injectedAt      DateTime?
  hitCount        Int       @default(1)
  savedAttempts   Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime

  @@index([hitCount])
  @@index([sourceModel])
  @@index([isInjected])
  @@index([errorCategory])
}

model AutonomousEvolutionRunLog {
  id           String    @id
  mode         String
  trigger      String    @default("manual")
  scanned      Int       @default(0)
  skipped      Int       @default(0)
  newFiles     Int       @default(0)
  sequences    Int       @default(0)
  created      Int       @default(0)
  merged       Int       @default(0)
  status       String    @default("running")
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([trigger])
  @@index([startedAt])
}

model CodeKnowledge {
  id         String   @id
  projectId  String
  entityType String
  name       String
  filePath   String
  lineStart  Int
  lineEnd    Int?
  parentId   String?
  calls      String?
  calledBy   String?
  signature  String?
  docstring  String?
  code       String?
  summary    String?
  riskScore  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([name])
  @@index([entityType])
  @@index([projectId])
}

model DataFlow {
  id          String   @id
  projectId   String
  sourceId    String
  sinkId      String
  sourceName  String
  sinkName    String
  path        String
  isUserInput Boolean  @default(false)
  isSensitive Boolean  @default(false)
  createdAt   DateTime @default(now())
  Project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([sinkId])
  @@index([sourceId])
  @@index([projectId])
}

model EvaluationIteration {
  id                   String            @id
  evaluationSessionId  String
  iterationNumber      Int
  status               String            @default("pending")
  startedAt            DateTime?
  completedAt          DateTime?
  duration             Int?
  responseText         String?
  inputTokens          Int?
  outputTokens         Int?
  toolCallCount        Int               @default(0)
  verificationComplete Boolean?
  verificationReason   String?
  errorMessage         String?
  modelConfigId        String?
  modelName            String?
  roleId               String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime
  ModelConfig          ModelConfig?      @relation(fields: [modelConfigId], references: [id])
  EvaluationSession    EvaluationSession @relation(fields: [evaluationSessionId], references: [id], onDelete: Cascade)

  @@unique([evaluationSessionId, iterationNumber])
  @@index([modelConfigId])
  @@index([evaluationSessionId])
  @@index([status])
  @@index([iterationNumber])
}

model EvaluationResult {
  id                String            @id
  evaluationId      String            @unique
  totalVulns        Int               @default(0)
  criticalCount     Int               @default(0)
  highCount         Int               @default(0)
  mediumCount       Int               @default(0)
  lowCount          Int               @default(0)
  infoCount         Int               @default(0)
  skillsUsed        String?
  rawReport         String?
  createdAt         DateTime          @default(now())
  EvaluationSession EvaluationSession @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
}

model EvaluationSession {
  id                        String                      @id
  projectId                 String
  workflowId                String?
  agentTeamId               String?
  modelConfigId             String?
  opencodeSessionId         String?                     @unique
  provider                  String                      @default("claude")
  title                     String?
  summary                   String?
  messageCount              Int                         @default(0)
  lastActivity              DateTime?                   @default(now())
  port                      Int?
  status                    String                      @default("running")
  startedAt                 DateTime                    @default(now())
  completedAt               DateTime?
  errorMessage              String?
  modelName                 String?
  providerType              String?
  totalInputTokens          Int                         @default(0)
  totalOutputTokens         Int                         @default(0)
  totalTokens               Int                         @default(0)
  estimatedCost             Float?
  roleModels                String?
  skillsUsed                String?
  endMessage                String?
  endReason                 String?
  workflowType              String?
  AgentTeamExecution        AgentTeamExecution[]
  AnalysisReport            AnalysisReport?
  EvaluationIteration       EvaluationIteration[]
  EvaluationResult          EvaluationResult?
  Project                   Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  AgentTeam                 AgentTeam?                  @relation(fields: [agentTeamId], references: [id])
  ModelConfig               ModelConfig?                @relation(fields: [modelConfigId], references: [id])
  NodeExecution             NodeExecution[]
  PhaseOutput               PhaseOutput[]
  Report                    Report?
  SessionMessage            SessionMessage[]
  SkillExecution            SkillExecution[]
  SkillVulnerabilityMapping SkillVulnerabilityMapping[]
  TokenUsage                TokenUsage[]
  Vulnerability             Vulnerability[]

  @@index([workflowType])
  @@index([projectId])
  @@index([agentTeamId])
  @@index([workflowId])
  @@index([modelConfigId])
  @@index([opencodeSessionId])
  @@index([status])
  @@index([provider])
  @@index([lastActivity])
}

model ExpectedOutputTemplate {
  id          String   @id
  name        String   @unique
  displayName String
  description String
  category    String
  template    String
  example     String?
  isActive    Boolean  @default(true)
  isBuiltin   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([isActive])
  @@index([category])
  @@index([name])
}

model ExperienceUsageLog {
  id           String   @id
  experienceId String
  evaluationId String
  projectId    String?
  source       String   @default("pre_injected")
  usedAt       DateTime @default(now())

  @@index([experienceId])
  @@index([evaluationId])
  @@index([usedAt])
  @@index([source])
}

model FSMTemplate {
  id          String     @id
  name        String     @unique
  displayName String
  description String?
  nodeCount   Int
  nodes       String
  agentZone   String?
  skillPath   String?
  version     String     @default("1.0.0")
  isActive    Boolean    @default(true)
  isBuiltin   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  Workflow    Workflow[]

  @@index([isBuiltin])
  @@index([isActive])
  @@index([name])
}

model IntegratedReport {
  id            String   @id
  reportId      String
  sourcePath    String
  sourceType    String
  format        String
  title         String?
  summary       String?
  findingsCount Int      @default(0)
  findings      String?
  rawContent    String?
  createdAt     DateTime @default(now())
  Report        Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([sourceType])
  @@index([reportId])
}

model LogFileRecord {
  id            String   @id
  filePath      String   @unique
  fileHash      String
  processedAt   DateTime @default(now())
  sequenceCount Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@index([filePath])
}

model McpServerConfig {
  id           String    @id
  userId       String
  projectId    String?
  name         String
  type         String
  command      String?
  args         String?
  url          String?
  env          String?
  tools        String? // JSON 格式存储工具列表 [{name, description, inputSchema}]
  isEnabled    Boolean   @default(true)
  autoStart    Boolean   @default(false)
  isShared     Boolean   @default(false)
  lastTestedAt DateTime? // 最后测试连接时间
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  Project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  User         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isShared])
  @@index([name])
  @@index([projectId])
  @@index([userId])
}

model ModelConfig {
  id                  String                @id
  userId              String?
  name                String
  providerType        String                @default("openai")
  apiBaseUrl          String
  apiKey              String
  models              String
  routeType           String?
  maxTokens           Int                   @default(32000)
  contextWindow       Int                   @default(0) // 模型的 context window 大小，0 表示不启用动态计算
  temperature         Float                 @default(0.3)
  isActive            Boolean               @default(true)
  isDefault           Boolean               @default(false)
  isPublic            Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  AgentDefinition     AgentDefinition[]
  EvaluationIteration EvaluationIteration[]
  EvaluationSession   EvaluationSession[]
  User                User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  NodeExecution       NodeExecution[]
  TaskInstance        TaskInstance[]

  @@index([userId])
  @@index([isActive])
  @@index([isDefault])
  @@index([isPublic])
  @@index([providerType])
  @@index([routeType])
}

model NodeExecution {
  id                  String            @id
  evaluationSessionId String
  workflowNodeId      String
  nodeLabel           String
  nodeType            String
  status              String            @default("pending")
  skipped             Boolean           @default(false)
  skipReason          String?
  startedAt           DateTime?
  completedAt         DateTime?
  order               Int               @default(0)
  modelConfigId       String?
  modelName           String?
  roleId              String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime
  opencodeSessionId   String?
  inputTokens         Int?
  outputTokens        Int?
  stopReason          String?
  compactionTriggered Boolean           @default(false)
  ModelConfig         ModelConfig?      @relation(fields: [modelConfigId], references: [id])
  EvaluationSession   EvaluationSession @relation(fields: [evaluationSessionId], references: [id], onDelete: Cascade)

  @@unique([evaluationSessionId, workflowNodeId])
  @@index([modelConfigId])
  @@index([evaluationSessionId])
  @@index([workflowNodeId])
  @@index([status])
  @@index([skipped])
}

model NotificationChannel {
  id        String   @id
  name      String   @unique
  type      String
  config    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([enabled])
  @@index([type])
}

model OpencodeConfig {
  id                       String    @id
  name                     String
  baseURL                  String    @default("http://localhost:54321")
  description              String?
  isActive                 Boolean   @default(true)
  keybinds                 String?
  modelPreferences         String?
  projectUploadDir         String?
  taskDescription          String?
  workflowConfig           String?
  customSystemPrompt       String?
  claudemdPath             String?
  resumeSession            Boolean   @default(false)
  permissionMode           String?
  settingSources           String?
  progressQuestion         String?
  skillOutputTemplate      String?
  claudemdTemplate         String?
  maxConcurrentEvaluations Int       @default(3)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime
  defaultToolPermissions   String?
  Project                  Project[]
  User                     User[]

  @@index([isActive])
}

model Permission {
  id          String   @id
  name        String   @unique
  description String?
  module      String
  action      String
  resource    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Role        Role[]

  @@unique([module, action])
  @@index([module])
}

model PhaseOutput {
  id                String             @id
  sessionId         String
  executionId       String?
  nodeId            String?
  phaseNumber       Int
  phaseName         String
  phases            String?
  outputYaml        String
  outputPath        String
  status            String             @default("pending")
  validatedAt       DateTime?
  errorMessage      String?
  findingsCount     Int?               @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  WorkflowExecution WorkflowExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)
  EvaluationSession EvaluationSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([phaseNumber])
  @@index([executionId])
  @@index([sessionId])
}

model Plugin {
  id          String   @id
  name        String   @unique
  displayName String
  description String
  version     String
  author      String
  type        String
  status      String   @default("inactive")
  config      String?
  pluginPath  String?
  isEnabled   Boolean  @default(false)
  isBuiltin   Boolean  @default(false)
  icon        String?
  homepage    String?
  repository  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([isEnabled])
  @@index([status])
  @@index([type])
  @@index([name])
}

model Project {
  id                        String                      @id
  userId                    String
  configId                  String?
  name                      String
  displayName               String?
  fullPath                  String?
  description               String?
  projectPath               String?
  status                    String                      @default("idle")
  isPublic                  Boolean                     @default(false)
  environmentUrl            String?
  adminUsername             String?
  adminPassword             String?
  normalUsername            String?
  normalPassword            String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  techStack                 String?
  AnalysisReport            AnalysisReport[]
  CodeKnowledge             CodeKnowledge[]
  DataFlow                  DataFlow[]
  EvaluationSession         EvaluationSession[]
  McpServerConfig           McpServerConfig[]
  User                      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  OpencodeConfig            OpencodeConfig?             @relation(fields: [configId], references: [id])
  ProjectFile               ProjectFile[]
  ProjectStructure          ProjectStructure?
  Report                    Report[]
  ScanTask                  ScanTask[]
  SessionMeta               SessionMeta?
  SkillExecution            SkillExecution[]
  SkillVulnerabilityMapping SkillVulnerabilityMapping[]
  ToolPermission            ToolPermission[]
  Vulnerability             Vulnerability[]

  @@index([userId])
  @@index([configId])
  @@index([status])
  @@index([name])
}

model ProjectFile {
  id         String   @id
  projectId  String
  fileName   String
  filePath   String
  fileSize   Float
  fileType   String
  uploadedAt DateTime @default(now())
  Project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectStructure {
  id            String    @id
  projectId     String    @unique
  structure     String
  fileCount     Int       @default(0)
  codeCount     Int       @default(0)
  languageStats String
  status        String    @default("pending")
  analyzedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Report {
  id                String             @id
  sessionId         String             @unique
  projectId         String
  reportType        String
  workflowType      String?
  fsmTemplate       String?
  title             String
  description       String?
  mainReportPath    String?
  mainReportContent String?
  subReports        String?
  totalFindings     Int                @default(0)
  criticalCount     Int                @default(0)
  highCount         Int                @default(0)
  mediumCount       Int                @default(0)
  lowCount          Int                @default(0)
  infoCount         Int                @default(0)
  dataSources       String?
  integratedReports String?
  rawContent        String?
  skillsUsed        String?
  status            String             @default("generated")
  generatedAt       DateTime           @default(now())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  IntegratedReport  IntegratedReport[]
  Project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  EvaluationSession EvaluationSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ReportSection     ReportSection[]

  @@index([status])
  @@index([workflowType])
  @@index([reportType])
  @@index([projectId])
  @@index([sessionId])
}

model ReportSection {
  id          String   @id
  reportId    String
  sectionId   String
  title       String
  order       Int
  contentPath String?
  content     String?
  metadata    String?
  createdAt   DateTime @default(now())
  Report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, sectionId])
  @@index([order])
  @@index([reportId])
}

model Role {
  id          String       @id
  name        String       @unique
  description String?
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  UserRole    UserRole[]
  Permission  Permission[]

  @@index([name])
}

model ScanReport {
  id         String   @id
  scanTaskId String
  projectId  String
  summary    String
  details    String
  format     String   @default("json")
  createdAt  DateTime @default(now())
  ScanTask   ScanTask @relation(fields: [scanTaskId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([scanTaskId])
}

model ScanTask {
  id              String           @id
  projectId       String
  userId          String
  name            String
  description     String?
  skillIds        String
  schedule        String?
  nextRunAt       DateTime?
  status          String           @default("pending")
  startedAt       DateTime?
  completedAt     DateTime?
  progress        Int              @default(0)
  currentSkill    String?
  totalSkills     Int              @default(0)
  completedSkills Int              @default(0)
  findingsCount   Int              @default(0)
  error           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  ScanReport      ScanReport[]
  Project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  SkillExecution  SkillExecution[]

  @@index([userId, status])
  @@index([createdAt])
  @@index([status])
  @@index([projectId])
}

model SessionMessage {
  id                  String            @id
  evaluationSessionId String
  workflowNodeId      String?
  skillExecutionId    String? // 关联到 SkillExecution（skill agent 的消息）
  role                String // user, assistant, tool_call, tool_result 等
  content             String? // 消息内容（可选，大内容存储在 JSONL）
  messageRef          String? // JSONL 文件中的消息 ID（用于从文件读取内容）
  createdAt           DateTime          @default(now())
  EvaluationSession   EvaluationSession @relation(fields: [evaluationSessionId], references: [id], onDelete: Cascade)
  SkillExecution      SkillExecution?   @relation(fields: [skillExecutionId], references: [id], onDelete: Cascade)

  @@index([workflowNodeId])
  @@index([evaluationSessionId])
  @@index([role])
  @@index([skillExecutionId])
}

model SessionMeta {
  id             String   @id
  projectId      String   @unique
  total          Int      @default(0)
  hasMore        Boolean  @default(false)
  claudeCount    Int      @default(0)
  cursorCount    Int      @default(0)
  codexCount     Int      @default(0)
  geminiCount    Int      @default(0)
  runningCount   Int      @default(0)
  completedCount Int      @default(0)
  failedCount    Int      @default(0)
  updatedAt      DateTime
  Project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Skill {
  id                                                     String                      @id
  userId                                                 String?

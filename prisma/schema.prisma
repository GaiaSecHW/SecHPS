// CodeSwarm Scheduler — Database Schema
// 只包含 3 个核心模型，Scheduler 独占

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CodeswarmTask {
  id                    String    @id @default(cuid())
  taskId                String    @unique
  workerId              String?
  state                 String    @default("queued") // queued/dispatched/building/running/completed/failed/cancelled
  instruction           String?
  projectPath           String?
  agentPath             String?
  workspacePath         String?
  gitUrl                String?
  gitRef                String?
  skills                String?   // JSON
  scripts               String?   // JSON
  mcps                  String?   // JSON
  model                 String?
  apiKey                String?
  timeoutSec            Int?
  engine                String?
  agent                 String?
  preferredWorkerNodeId String?
  targetProduct         String?
  apiBaseUrl            String?
  maxTokens             Int?
  contextWindow         Int?
  env                   String?   // JSON

  // 平台关联（跨服务）
  platformTaskId        String?   // 外部平台的 TaskInstance ID
  platformCallbackUrl   String?   // 任务完成时回调平台

  // Tool 调度字段
  toolId                String?   // Tool 标识符
  toolTaskId            String?   // 组合 ID: toolId + uuid + timestamp
  toolPath              String?   // Tool 可执行路径
  toolWorkDir           String?   // TOOL_WORK_DIR 根目录

  sessionId             String?
  events                String?   @db.Text // legacy JSON
  result                String?   @db.Text
  error                 String?   @db.Text
  reportContent         String?   @db.Text
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  CodeswarmWorker       CodeswarmWorker? @relation(fields: [workerId], references: [id])

  @@index([createdAt])
  @@index([workerId])
  @@index([state])
  @@index([platformTaskId])
}

model CodeswarmWorker {
  id            String    @id @default(cuid())
  nodeId        String    @unique
  address       String    @default("")
  systemType    String?
  arch          String?
  status        String    @default("offline") // online/offline/draining
  maxConcurrent Int       @default(5)
  currentTasks  Int       @default(0)
  name          String?
  capabilities  String?   // JSON
  token         String?
  lastHeartbeat DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  CodeswarmTasks CodeswarmTask[]
}

model CodeswarmEvent {
  id        String   @id @default(cuid())
  taskId    String   // 关联 CodeswarmTask.taskId（非 FK，跨表查询用）
  type      String
  data      String   @db.Text // JSON string
  level     String?  // worker | agent
  stream    String?  // stdout | stderr
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([taskId, createdAt])
  @@index([taskId, level])
}

  User_WorkflowShare_sharedByToUser   User      @relation("WorkflowShare_sharedByToUser", fields: [sharedBy], references: [id], onDelete: Cascade)
  Workflow                            Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)


generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AgentApp {
  id                String   @id
  userId            String
  tenantId          String?
  name              String
  engine            String
  agentHarnessPath  String?
  defaultAgentName  String?  @default("default-agent")
  startCommand      String?
  notes             String?
  inputRequirements String?
  requireCodedmap   Boolean  @default(false)
  status            String   @default("active")
  isPublic          Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @db.Timestamptz
  Tenant            Tenant?  @relation(fields: [tenantId], references: [id])
  User              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ApiKeyAgents      ApiKeyAgent[]
  Project           Project[]
  AgentFlowPipeline AgentFlowPipeline[]

  @@index([tenantId])
  @@index([userId])
}

model AgentDefinition {
  id              String            @id
  userId          String?
  tenantId        String?
  name            String            @unique
  displayName     String
  description     String?
  category        String
  modelConfigId   String?
  model           String
  systemPrompt    String?
  allowedTools    String?
  skills          String?
  isActive        Boolean           @default(true)
  isBuiltin       Boolean           @default(false)
  isPublic        Boolean           @default(false)
  createdAt       DateTime          @default(now()) @db.Timestamptz
  updatedAt       DateTime @db.Timestamptz
  ModelConfig     ModelConfig?      @relation(fields: [modelConfigId], references: [id])
  User            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  Tenant          Tenant?           @relation(fields: [tenantId], references: [id])
  AgentTeam       AgentTeam[]
  AgentTeamMember AgentTeamMember[]

  @@index([isActive])
  @@index([category])
  @@index([name])
  @@index([tenantId])
  @@index([isPublic])
}

model AgentMemberExecution {
  id                 String             @id
  teamExecutionId    String
  memberId           String
  status             String             @default("pending")
  startedAt          DateTime? @db.Timestamptz
  completedAt        DateTime? @db.Timestamptz
  inputTokens        Int                @default(0)
  outputTokens       Int                @default(0)
  createdAt          DateTime           @default(now()) @db.Timestamptz
  AgentTeamMember    AgentTeamMember    @relation(fields: [memberId], references: [id])
  AgentTeamExecution AgentTeamExecution @relation(fields: [teamExecutionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([memberId])
  @@index([teamExecutionId])
}

model AgentTeam {
  id                 String               @id
  userId             String
  tenantId           String?
  name               String
  description        String?
  leadAgentId        String
  taskStrategy       String?              @default("parallel")
  maxTeammates       Int                  @default(5)
  status             String               @default("idle")
  ralphConfig        String?
  createdAt          DateTime             @default(now()) @db.Timestamptz
  updatedAt          DateTime @db.Timestamptz
  Tenant             Tenant?              @relation(fields: [tenantId], references: [id])
  AgentDefinition    AgentDefinition      @relation(fields: [leadAgentId], references: [id], onDelete: Cascade)
  User               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  AgentTeamExecution AgentTeamExecution[]
  AgentTeamMember    AgentTeamMember[]
  EvaluationSession  EvaluationSession[]

  @@index([leadAgentId])
  @@index([status])
  @@index([tenantId])
  @@index([userId])
}

model AgentTeamExecution {
  id                   String                 @id
  teamId               String
  evaluationId         String?
  status               String                 @default("pending")
  startedAt            DateTime? @db.Timestamptz
  completedAt          DateTime? @db.Timestamptz
  totalInputTokens     Int                    @default(0)
  totalOutputTokens    Int                    @default(0)
  createdAt            DateTime               @default(now()) @db.Timestamptz
  AgentMemberExecution AgentMemberExecution[]
  EvaluationSession    EvaluationSession?     @relation(fields: [evaluationId], references: [id])
  AgentTeam            AgentTeam              @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([evaluationId])
  @@index([teamId])
}

model AgentTeamMember {
  id                   String                 @id
  teamId               String
  agentId              String
  role                 String
  overrideModel        String?
  overrideTools        String?
  createdAt            DateTime               @default(now()) @db.Timestamptz
  AgentMemberExecution AgentMemberExecution[]
  AgentDefinition      AgentDefinition        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  AgentTeam            AgentTeam              @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([teamId])
}

model AlertInstance {
  id               String    @id
  ruleId           String
  ruleName         String
  severity         String
  status           String    @default("active")
  message          String
  value            Float
  threshold        Float
  triggeredAt      DateTime  @default(now()) @db.Timestamptz
  resolvedAt       DateTime? @db.Timestamptz
  acknowledgedAt   DateTime? @db.Timestamptz
  acknowledgedBy   String?
  details          String?
  notifiedChannels String?
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime @db.Timestamptz
  AlertRule        AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([status])
  @@index([severity])
  @@index([triggeredAt])
}

model AlertRule {
  id                   String          @id
  name                 String          @unique
  description          String?
  metricType           String
  condition            String
  severity             String          @default("medium")
  enabled              Boolean         @default(true)
  cooldownPeriod       Int             @default(300)
  notificationChannels String
  tags                 String?
  lastTriggeredAt      DateTime? @db.Timestamptz
  triggerCount         Int             @default(0)
  createdAt            DateTime        @default(now()) @db.Timestamptz
  updatedAt            DateTime @db.Timestamptz
  AlertInstance        AlertInstance[]

  @@index([metricType])
  @@index([enabled])
  @@index([severity])
}

model AnalysisReport {
  id                  String            @id
  evaluationId        String            @unique
  projectId           String
  projectName         String
  description         String
  techStack           String?
  projectType         String?
  frontend            String?
  backend             String?
  database            String?
  directoryStructure  String?
  architectureSummary String?
  apiEndpoints        String?
  pageEntries         String?
  userInputPoints     String?
  entryPointsSummary  String?
  authType            String?
  tokenStorage        String?
  tokenExpiry         String?
  refreshMechanism    String?
  authzModel          String?
  roles               String?
  sessionManagement   String?
  securityConfig      String?
  authSummary         String?
  analyzedAt          DateTime? @db.Timestamptz
  rawContent          String?
  createdAt           DateTime          @default(now()) @db.Timestamptz
  updatedAt           DateTime @db.Timestamptz
  EvaluationSession   EvaluationSession @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  Project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@index([projectId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id
  userId    String?
  action    String
  resource  String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([action, createdAt])
}

model AutonomousEvolutionExperience {
  id              String    @id
  title           String
  errorCategory   String
  errorPatterns   String
  sourceModel     String
  sourceSessionId String
  sourceProjectId String?
  attemptSequence String
  directSolution  String
  lesson          String
  isInjected      Boolean   @default(false)
  injectedAt      DateTime? @db.Timestamptz
  hitCount        Int       @default(1)
  savedAttempts   Float     @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime @db.Timestamptz

  @@index([errorCategory])
  @@index([isInjected])
  @@index([sourceModel])
  @@index([hitCount])
}

model AutonomousEvolutionRunLog {
  id           String    @id
  mode         String
  trigger      String    @default("manual")
  scanned      Int       @default(0)
  skipped      Int       @default(0)
  newFiles     Int       @default(0)
  sequences    Int       @default(0)
  created      Int       @default(0)
  merged       Int       @default(0)
  status       String    @default("running")
  errorMessage String?
  startedAt    DateTime  @default(now()) @db.Timestamptz
  finishedAt   DateTime? @db.Timestamptz

  @@index([startedAt])
  @@index([trigger])
}

model CodeKnowledge {
  id         String   @id
  projectId  String
  entityType String
  name       String
  filePath   String
  lineStart  Int
  lineEnd    Int?
  parentId   String?
  calls      String?
  calledBy   String?
  signature  String?
  docstring  String?
  code       String?
  summary    String?
  riskScore  Float?
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @db.Timestamptz
  Project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([entityType])
  @@index([name])
}

model CodeswarmTask {
  id                String           @id
  taskId            String           @unique
  workerId          String?
  state             String           @default("queued")
  instruction       String?
  projectPath       String?
  workspacePath     String?
  gitUrl            String?
  gitRef            String?
  skills            String?
  scripts           String?
  mcps              String?
  model             String?
  apiKey            String?
  timeoutSec        Int?
  engine            String?
  agent             String?
  preferredWorkerNodeId String?
  targetProduct     String?
  apiBaseUrl       String?
  platformTaskId    String?
  sessionId         String?
  events            String?
  result            String?
  error             String?
  reportContent     String?
  startedAt         DateTime? @db.Timestamptz
  completedAt       DateTime? @db.Timestamptz
  createdAt         DateTime         @default(now()) @db.Timestamptz
  updatedAt         DateTime @db.Timestamptz
  CodeswarmWorker   CodeswarmWorker? @relation(fields: [workerId], references: [id])

  @@index([createdAt])
  @@index([workerId])
  @@index([state])
}

model CodeswarmWorker {
  id            String          @id
  nodeId        String          @unique
  address       String
  systemType    String?         // 系统类型: linux, windows, darwin
  arch          String?         // CPU架构: x64, x86, arm64, armv7
  status        String          @default("online")
  maxConcurrent Int             @default(5)
  currentTasks  Int             @default(0)
  lastHeartbeat DateTime        @default(now()) @db.Timestamptz
  token         String?
  createdAt     DateTime        @default(now()) @db.Timestamptz
  updatedAt     DateTime @db.Timestamptz
  CodeswarmTask CodeswarmTask[]
}

model CodeswarmEvent {
  id        String   @id @default(cuid())
  taskId    String
  type      String
  data      String
  level     String   @default("agent")   // 日志层级: "worker" | "agent"
  stream    String?                       // 输出流: "stdout" | "stderr" | null
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([taskId])
  @@index([taskId, createdAt])
  @@index([taskId, level])
}

model DataFlow {
  id          String   @id
  projectId   String
  sourceId    String
  sinkId      String
  sourceName  String
  sinkName    String
  path        String
  isUserInput Boolean  @default(false)
  isSensitive Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz
  Project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sourceId])
  @@index([sinkId])
}

model EvaluationIteration {
  id                   String            @id
  evaluationSessionId  String
  iterationNumber      Int
  status               String            @default("pending")
  startedAt            DateTime? @db.Timestamptz
  completedAt          DateTime? @db.Timestamptz
  duration             Int?
  responseText         String?
  inputTokens          Int?
  outputTokens         Int?
  toolCallCount        Int               @default(0)
  verificationComplete Boolean?
  verificationReason   String?
  errorMessage         String?
  modelConfigId        String?
  modelName            String?
  roleId               String?
  createdAt            DateTime          @default(now()) @db.Timestamptz
  updatedAt            DateTime @db.Timestamptz
  EvaluationSession    EvaluationSession @relation(fields: [evaluationSessionId], references: [id], onDelete: Cascade)
  ModelConfig          ModelConfig?      @relation(fields: [modelConfigId], references: [id])

  @@unique([evaluationSessionId, iterationNumber])
  @@index([iterationNumber])
  @@index([status])
  @@index([evaluationSessionId])
  @@index([modelConfigId])
}

model EvaluationResult {
  id                String            @id
  evaluationId      String            @unique
  totalVulns        Int               @default(0)
  criticalCount     Int               @default(0)
  highCount         Int               @default(0)
  mediumCount       Int               @default(0)
  lowCount          Int               @default(0)
  infoCount         Int               @default(0)
  skillsUsed        String?
  rawReport         String?
  createdAt         DateTime          @default(now()) @db.Timestamptz
  EvaluationSession EvaluationSession @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
}

model EvaluationSession {
  id                        String                      @id
  projectId                 String
  workflowId                String?
  agentTeamId               String?
  modelConfigId             String?
  opencodeSessionId         String?                     @unique
  provider                  String                      @default("claude")
  title                     String?
  summary                   String?
  messageCount              Int                         @default(0)
  lastActivity              DateTime?                   @default(now()) @db.Timestamptz
  port                      Int?
  status                    String                      @default("running")
  startedAt                 DateTime                    @default(now()) @db.Timestamptz
  completedAt               DateTime? @db.Timestamptz
  errorMessage              String?
  modelName                 String?
  providerType              String?
  totalInputTokens          Int                         @default(0)
  totalOutputTokens         Int                         @default(0)
  totalTokens               Int                         @default(0)
  estimatedCost             Float?
  roleModels                String?
  skillsUsed                String?
  endMessage                String?
  endReason                 String?
  workflowType              String?
  AgentTeamExecution        AgentTeamExecution[]
  AnalysisReport            AnalysisReport?
  EvaluationIteration       EvaluationIteration[]
  EvaluationResult          EvaluationResult?
  ModelConfig               ModelConfig?                @relation(fields: [modelConfigId], references: [id])
  AgentTeam                 AgentTeam?                  @relation(fields: [agentTeamId], references: [id])
  Project                   Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  NodeExecution             NodeExecution[]
  PhaseOutput               PhaseOutput[]
  Report                    Report?
  SessionMessage            SessionMessage[]
  SkillExecution            SkillExecution[]
  SkillVulnerabilityMapping SkillVulnerabilityMapping[]
  TokenUsage                TokenUsage[]
  Vulnerability             Vulnerability[]

  @@index([lastActivity])
  @@index([provider])
  @@index([status])
  @@index([opencodeSessionId])
  @@index([modelConfigId])
  @@index([workflowId])
  @@index([agentTeamId])
  @@index([projectId])
  @@index([workflowType])
}

model EvolutionAttempt {
  id                         String             @id
  taskId                     String
  attemptNumber              Int
  falsePositiveCasesUsed     String?
  confirmedCasesUsed         String?
  falsePositivePatterns      String?
  confirmedPatterns          String?
  recommendations            String?
  improvedContent            String?
  changeSummary              String?
  backtestSummary            String?
  falsePositiveExclusionRate Float?
  confirmedMissed            Int                @default(0)
  backtestDetailRows         String?
  failureReason              String?
  missedCasesInfo            String?
  remainingFalsePositive     String?
  isPassed                   Boolean            @default(false)
  status                     String             @default("pending")
  createdAt                  DateTime           @default(now()) @db.Timestamptz
  SkillEvolutionTask         SkillEvolutionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([attemptNumber])
  @@index([taskId])
}

model ExpectedOutputTemplate {
  id          String   @id
  name        String   @unique
  displayName String
  description String
  category    String
  template    String
  example     String?
  isActive    Boolean  @default(true)
  isBuiltin   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @db.Timestamptz

  @@index([name])
  @@index([category])
  @@index([isActive])
}

model ExperienceUsageLog {
  id           String   @id
  experienceId String
  evaluationId String
  projectId    String?
  source       String   @default("pre_injected")
  usedAt       DateTime @default(now()) @db.Timestamptz

  @@index([source])
  @@index([usedAt])
  @@index([evaluationId])
  @@index([experienceId])
}

model FSMTemplate {
  id          String     @id
  name        String     @unique
  displayName String
  description String?
  nodeCount   Int
  nodes       String
  agentZone   String?
  skillPath   String?
  version     String     @default("1.0.0")
  isActive    Boolean    @default(true)
  isBuiltin   Boolean    @default(false)
  createdAt   DateTime   @default(now()) @db.Timestamptz
  updatedAt   DateTime @db.Timestamptz
  Workflow    Workflow[]

  @@index([name])
  @@index([isActive])
  @@index([isBuiltin])
}

model IntegratedReport {
  id            String   @id
  reportId      String
  sourcePath    String
  sourceType    String
  format        String
  title         String?
  summary       String?
  findingsCount Int      @default(0)
  findings      String?
  rawContent    String?
  createdAt     DateTime @default(now()) @db.Timestamptz
  Report        Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([sourceType])
}

model LogFileRecord {
  id            String   @id
  filePath      String   @unique
  fileHash      String
  processedAt   DateTime @default(now()) @db.Timestamptz
  sequenceCount Int      @default(0)
  updatedAt     DateTime @db.Timestamptz

  @@index([filePath])
}

model McpServerConfig {
  id           String    @id
  userId       String
  tenantId     String?
  projectId    String?
  name         String
  type         String
  command      String?
  args         String?
  url          String?
  env          String?
  tools        String?
  isEnabled    Boolean   @default(true)
  autoStart    Boolean   @default(false)
  isPublic     Boolean   @default(false)
  lastTestedAt DateTime? @db.Timestamptz
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime @db.Timestamptz
  Tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  User         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([projectId])
  @@index([name])
  @@index([isPublic])
}

model ModelConfig {
  id                  String                @id
  userId              String?
  tenantId            String?
  name                String
  providerType        String                @default("openai")
  apiBaseUrl          String
  apiKey              String
  models              String
  routeType           String?
  maxTokens           Int                   @default(32000)
  contextWindow       Int                   @default(0)
  temperature         Float                 @default(0.3)
  isActive            Boolean               @default(true)
  isDefault           Boolean               @default(false)
  isPublic            Boolean               @default(false)
  createdAt           DateTime              @default(now()) @db.Timestamptz
  updatedAt           DateTime @db.Timestamptz
  AgentDefinition     AgentDefinition[]
  EvaluationIteration EvaluationIteration[]
  EvaluationSession   EvaluationSession[]
  Tenant              Tenant?               @relation(fields: [tenantId], references: [id])
  User                User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  NodeExecution       NodeExecution[]
  TaskInstance        TaskInstance[]

  @@index([routeType])
  @@index([providerType])
  @@index([isPublic])
  @@index([isDefault])
  @@index([isActive])
  @@index([tenantId])
  @@index([userId])
}

model NodeExecution {
  id                  String            @id
  evaluationSessionId String
  workflowNodeId      String
  nodeLabel           String
  nodeType            String
  status              String            @default("pending")
  skipped             Boolean           @default(false)
  skipReason          String?
  startedAt           DateTime? @db.Timestamptz
  completedAt         DateTime? @db.Timestamptz
  order               Int               @default(0)
  modelConfigId       String?
  modelName           String?
  roleId              String?
  createdAt           DateTime          @default(now()) @db.Timestamptz
  updatedAt           DateTime @db.Timestamptz
  opencodeSessionId   String?
  inputTokens         Int?
  outputTokens        Int?
  stopReason          String?
  compactionTriggered Boolean           @default(false)
  EvaluationSession   EvaluationSession @relation(fields: [evaluationSessionId], references: [id], onDelete: Cascade)
  ModelConfig         ModelConfig?      @relation(fields: [modelConfigId], references: [id])

  @@unique([evaluationSessionId, workflowNodeId])
  @@index([skipped])
  @@index([status])
  @@index([workflowNodeId])
  @@index([evaluationSessionId])
  @@index([modelConfigId])
}

model NotificationChannel {
  id        String   @id
  name      String   @unique
  type      String
  config    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @db.Timestamptz

  @@index([type])
  @@index([enabled])
}

model OpencodeConfig {
  id                       String    @id
  name                     String
  baseURL                  String    @default("http://localhost:54321")
  description              String?
  isActive                 Boolean   @default(true)
  keybinds                 String?
  modelPreferences         String?
  projectUploadDir         String?
  taskDescription          String?
  workflowConfig           String?
  customSystemPrompt       String?
  claudemdPath             String?
  resumeSession            Boolean   @default(false)
  permissionMode           String?
  settingSources           String?
  progressQuestion         String?
  skillOutputTemplate      String?
  claudemdTemplate         String?
  maxConcurrentEvaluations Int       @default(3)
  createdAt                DateTime  @default(now()) @db.Timestamptz
  updatedAt                DateTime @db.Timestamptz
  defaultToolPermissions   String?
  fileValidationModel      String?
  Project                  Project[]
  User                     User[]

  @@index([isActive])
}

model Permission {
  id          String   @id
  name        String   @unique
  description String?
  module      String
  action      String
  resource    String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @db.Timestamptz
  Role        Role[]

  @@unique([module, action])
  @@index([module])
}

model PhaseOutput {
  id                String             @id
  sessionId         String
  executionId       String?
  nodeId            String?
  phaseNumber       Int
  phaseName         String
  phases            String?
  outputYaml        String
  outputPath        String
  status            String             @default("pending")
  validatedAt       DateTime? @db.Timestamptz
  errorMessage      String?
  findingsCount     Int?               @default(0)
  createdAt         DateTime           @default(now()) @db.Timestamptz
  updatedAt         DateTime @db.Timestamptz
  EvaluationSession EvaluationSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  WorkflowExecution WorkflowExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([executionId])
  @@index([phaseNumber])
  @@index([status])
}

model Plugin {
  id          String   @id
  name        String   @unique
  displayName String
  description String
  version     String
  author      String
  type        String
  status      String   @default("inactive")
  config      String?
  pluginPath  String?
  isEnabled   Boolean  @default(false)
  isBuiltin   Boolean  @default(false)
  icon        String?
  homepage    String?
  repository  String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @db.Timestamptz

  @@index([name])
  @@index([type])
  @@index([status])
  @@index([isEnabled])
}

model Project {
  id                        String                      @id
  userId                    String
  tenantId                  String?
  configId                  String?
  name                      String
  displayName               String?
  fullPath                  String?
  description               String?
  projectPath               String?
  status                    String                      @default("idle")
  isPublic                  Boolean                     @default(false)
  environmentUrl            String?
  adminUsername             String?
  adminPassword             String?
  normalUsername            String?
  normalPassword            String?
  createdAt                 DateTime                    @default(now()) @db.Timestamptz
  updatedAt                 DateTime @db.Timestamptz

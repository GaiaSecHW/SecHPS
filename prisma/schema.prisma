generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AgentDefinition {
  id              String            @id
  userId          String?
  name            String            @unique
  displayName     String
  description     String?
  category        String
  modelConfigId   String?
  model           String
  systemPrompt    String?
  allowedTools    String?
  skills          String?
  mcpServers      String?
  isActive        Boolean           @default(true)
  isBuiltin       Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  User            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ModelConfig     ModelConfig?      @relation(fields: [modelConfigId], references: [id])
  AgentTeam       AgentTeam[]
  AgentTeamMember AgentTeamMember[]

  @@index([name])
  @@index([category])
  @@index([isActive])
}

model AgentMemberExecution {
  id                 String             @id
  teamExecutionId    String
  memberId           String
  status             String             @default("pending")
  startedAt          DateTime?
  completedAt        DateTime?
  inputTokens        Int                @default(0)
  outputTokens       Int                @default(0)
  createdAt          DateTime           @default(now())
  AgentTeamExecution AgentTeamExecution @relation(fields: [teamExecutionId], references: [id], onDelete: Cascade)
  AgentTeamMember    AgentTeamMember    @relation(fields: [memberId], references: [id])

  @@index([teamExecutionId])
  @@index([memberId])
  @@index([status])
}

model AgentTeam {
  id                 String               @id
  userId             String
  name               String
  description        String?
  leadAgentId        String
  taskStrategy       String?              @default("parallel")
  maxTeammates       Int                  @default(5)
  status             String               @default("idle")
  ralphConfig        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  User               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  AgentDefinition    AgentDefinition      @relation(fields: [leadAgentId], references: [id], onDelete: Cascade)
  AgentTeamExecution AgentTeamExecution[]
  AgentTeamMember    AgentTeamMember[]
  EvaluationSession  EvaluationSession[]

  @@index([userId])
  @@index([status])
  @@index([leadAgentId])
}

model AgentTeamExecution {
  id                   String                 @id
  teamId               String
  evaluationId         String?
  status               String                 @default("pending")
  startedAt            DateTime?
  completedAt          DateTime?
  totalInputTokens     Int                    @default(0)
  totalOutputTokens    Int                    @default(0)
  createdAt            DateTime               @default(now())
  AgentMemberExecution AgentMemberExecution[]
  AgentTeam            AgentTeam              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  EvaluationSession    EvaluationSession?     @relation(fields: [evaluationId], references: [id])

  @@index([teamId])
  @@index([evaluationId])
  @@index([status])
}

model AgentTeamMember {
  id                   String                 @id
  teamId               String
  agentId              String
  role                 String
  overrideModel        String?
  overrideTools        String?
  createdAt            DateTime               @default(now())
  AgentMemberExecution AgentMemberExecution[]
  AgentTeam            AgentTeam              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  AgentDefinition      AgentDefinition        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([agentId])
}

model AlertInstance {
  id               String    @id
  ruleId           String
  ruleName         String
  severity         String
  status           String    @default("active")
  message          String
  value            Float
  threshold        Float
  triggeredAt      DateTime  @default(now())
  resolvedAt       DateTime?
  acknowledgedAt   DateTime?
  acknowledgedBy   String?
  details          String?
  notifiedChannels String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  AlertRule        AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([triggeredAt])
  @@index([severity])
  @@index([status])
  @@index([ruleId])
}

model AlertRule {
  id                   String          @id
  name                 String          @unique
  description          String?
  metricType           String
  condition            String
  severity             String          @default("medium")
  enabled              Boolean         @default(true)
  cooldownPeriod       Int             @default(300)
  notificationChannels String
  tags                 String?
  lastTriggeredAt      DateTime?
  triggerCount         Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime
  AlertInstance        AlertInstance[]

  @@index([severity])
  @@index([enabled])
  @@index([metricType])
}

model AuditLog {
  id        String   @id
  userId    String?
  action    String
  resource  String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([createdAt])
  @@index([action])
  @@index([userId])
}

model AutonomousEvolutionExperience {
  id              String    @id
  title           String
  errorCategory   String
  errorPatterns   String
  sourceModel     String
  sourceSessionId String
  sourceProjectId String?
  attemptSequence String
  directSolution  String
  lesson          String
  isInjected      Boolean   @default(false)
  injectedAt      DateTime?
  hitCount        Int       @default(1)
  savedAttempts   Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime

  @@index([hitCount])
  @@index([sourceModel])
  @@index([isInjected])
  @@index([errorCategory])
}

model AutonomousEvolutionRunLog {
  id           String    @id
  mode         String
  trigger      String    @default("manual")
  scanned      Int       @default(0)
  skipped      Int       @default(0)
  newFiles     Int       @default(0)
  sequences    Int       @default(0)
  created      Int       @default(0)
  merged       Int       @default(0)
  status       String    @default("running")
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([trigger])
  @@index([startedAt])
}

model CodeKnowledge {
  id         String   @id
  projectId  String
  entityType String
  name       String
  filePath   String
  lineStart  Int
  lineEnd    Int?
  parentId   String?
  calls      String?
  calledBy   String?
  signature  String?
  docstring  String?
  code       String?
  summary    String?
  riskScore  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([name])
  @@index([entityType])
  @@index([projectId])
}

model DataFlow {
  id          String   @id
  projectId   String
  sourceId    String
  sinkId      String
  sourceName  String
  sinkName    String
  path        String
  isUserInput Boolean  @default(false)
  isSensitive Boolean  @default(false)
  createdAt   DateTime @default(now())
  Project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([sinkId])
  @@index([sourceId])
  @@index([projectId])
}

model EvaluationIteration {
  id                   String            @id
  evaluationSessionId  String
  iterationNumber      Int
  status               String            @default("pending")
  startedAt            DateTime?
  completedAt          DateTime?
  duration             Int?
  responseText         String?
  inputTokens          Int?
  outputTokens         Int?
  toolCallCount        Int               @default(0)
  verificationComplete Boolean?
  verificationReason   String?
  errorMessage         String?
  // ===== 新增字段：模型信息 =====
  modelConfigId        String? // 本次迭代使用的模型配置ID
  modelName            String? // 本次迭代使用的模型名称
  roleId               String? // 本次迭代对应的角色ID
  createdAt            DateTime          @default(now())
  updatedAt            DateTime
  EvaluationSession    EvaluationSession @relation(fields: [evaluationSessionId], references: [id], onDelete: Cascade)
  ModelConfig          ModelConfig?      @relation(fields: [modelConfigId], references: [id])

  @@unique([evaluationSessionId, iterationNumber])
  @@index([iterationNumber])
  @@index([status])
  @@index([evaluationSessionId])
  @@index([modelConfigId])
}

model EvaluationResult {
  id                String            @id
  evaluationId      String            @unique
  totalVulns        Int               @default(0)
  criticalCount     Int               @default(0)
  highCount         Int               @default(0)
  mediumCount       Int               @default(0)
  lowCount          Int               @default(0)
  infoCount         Int               @default(0)
  skillsUsed        String?
  rawReport         String?
  createdAt         DateTime          @default(now())
  EvaluationSession EvaluationSession @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
}

model EvaluationSession {
  id                String    @id
  projectId         String
  workflowId        String?
  agentTeamId       String?
  modelConfigId     String?
  roleModels        String? // JSON: [{ roleId, modelId }]
  skillsUsed        String? // JSON: [{ skillId, skillName }] 本次评估使用的 Skill 列表
  opencodeSessionId String?   @unique
  provider          String    @default("claude")
  title             String?
  summary           String?
  messageCount      Int       @default(0)
  lastActivity      DateTime? @default(now())
  port              Int?
  status            String    @default("running")
  endReason         String? // 结束原因: "completed" | "stopped" | "error"
  endMessage        String? // 结束详细信息（错误信息等）
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  errorMessage      String?
  modelName         String?
  providerType      String?
  todoList          String?
  totalInputTokens  Int       @default(0)
  totalOutputTokens Int       @default(0)
  totalTokens       Int       @default(0)
  estimatedCost     Float?

  // FSM 工作流扩展
  workflowType String? // "dag" | "fsm"

  AgentTeamExecution        AgentTeamExecution[]
  AnalysisReport            AnalysisReport?
  EvaluationIteration       EvaluationIteration[]
  EvaluationResult          EvaluationResult?
  Project                   Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  AgentTeam                 AgentTeam?                  @relation(fields: [agentTeamId], references: [id])
  ModelConfig               ModelConfig?                @relation(fields: [modelConfigId], references: [id])
  NodeExecution             NodeExecution[]
  SessionMessage            SessionMessage[]
  SkillExecution            SkillExecution[] // Skill 执行记录
  TokenUsage                TokenUsage[]
  Vulnerability             Vulnerability[]
  SkillVulnerabilityMapping SkillVulnerabilityMapping[]

  // 新增关联
  Report      Report?
  PhaseOutput PhaseOutput[]

  @@index([projectId])
  @@index([agentTeamId])
  @@index([workflowId])
  @@index([modelConfigId])
  @@index([opencodeSessionId])
  @@index([status])
  @@index([provider])
  @@index([lastActivity])
  @@index([workflowType])
}

model AnalysisReport {
  id           String @id
  evaluationId String @unique
  projectId    String

  // 项目概况
  projectName String
  description String // SQLite 默认使用 TEXT 类型存储长字符串
  techStack   String? // JSON array

  // 架构分析
  projectType         String?
  frontend            String?
  backend             String?
  database            String?
  directoryStructure  String? // JSON object
  architectureSummary String?

  // 入口点分析
  apiEndpoints       String? // JSON array
  pageEntries        String? // JSON array
  userInputPoints    String? // JSON array
  entryPointsSummary String?

  // 认证鉴权分析
  authType          String?
  tokenStorage      String?
  tokenExpiry       String?
  refreshMechanism  String?
  authzModel        String?
  roles             String? // JSON array
  sessionManagement String? // JSON object
  securityConfig    String? // JSON object
  authSummary       String?

  // 元数据
  analyzedAt DateTime?
  rawContent String? // 大模型原始输出
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  EvaluationSession EvaluationSession @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  Project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@index([projectId])
  @@index([createdAt])
}

model ExpectedOutputTemplate {
  id          String   @id
  name        String   @unique
  displayName String
  description String
  category    String
  template    String
  example     String?
  isActive    Boolean  @default(true)
  isBuiltin   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([isActive])
  @@index([category])
  @@index([name])
}

model ExperienceUsageLog {
  id           String   @id
  experienceId String
  evaluationId String
  projectId    String?
  source       String   @default("pre_injected")
  usedAt       DateTime @default(now())

  @@index([experienceId])
  @@index([evaluationId])
  @@index([usedAt])
  @@index([source])
}

model LogFileRecord {
  id            String   @id
  filePath      String   @unique
  fileHash      String
  processedAt   DateTime @default(now())
  sequenceCount Int      @default(0)

  @@index([filePath])
}

model McpServerConfig {
  id        String   @id
  userId    String
  projectId String?
  name      String
  type      String
  command   String?
  args      String?
  url       String?
  env       String?
  isEnabled Boolean  @default(true)
  autoStart Boolean  @default(false)
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime
  Project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isShared])
  @@index([name])
  @@index([projectId])
  @@index([userId])
}

model ModelConfig {
  id                  String                @id
  userId              String?
  name                String
  providerType        String                @default("openai")
  apiBaseUrl          String
  apiKey              String
  models              String
  routeType           String?
  maxTokens           Int                   @default(4096) // 最大输出 token 数
  temperature         Float                 @default(0.7) // 温度参数
  isActive            Boolean               @default(true)
  isDefault           Boolean               @default(false)
  isPublic            Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  AgentDefinition     AgentDefinition[]
  EvaluationSession   EvaluationSession[]
  EvaluationIteration EvaluationIteration[] // 新增：迭代关联
  NodeExecution       NodeExecution[] // 新增：节点执行关联
  User                User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([routeType])
  @@index([providerType])
  @@index([isPublic])
  @@index([isDefault])
  @@index([isActive])
  @@index([userId])
}

model NodeExecution {
  id                  String            @id
  evaluationSessionId String
  workflowNodeId      String
  nodeLabel           String
  nodeType            String
  status              String            @default("pending")
  startedAt           DateTime?
  completedAt         DateTime?
  order               Int               @default(0)
  // ===== 新增字段：模型信息 =====
  modelConfigId       String? // 节点使用的模型配置ID
  modelName           String? // 节点使用的模型名称
  roleId              String? // 节点关联的角色ID
  createdAt           DateTime          @default(now())
  updatedAt           DateTime
  EvaluationSession   EvaluationSession @relation(fields: [evaluationSessionId], references: [id], onDelete: Cascade)
  ModelConfig         ModelConfig?      @relation(fields: [modelConfigId], references: [id])

  @@unique([evaluationSessionId, workflowNodeId])
  @@index([status])
  @@index([workflowNodeId])
  @@index([evaluationSessionId])
  @@index([modelConfigId])
}

model NotificationChannel {
  id        String   @id
  name      String   @unique
  type      String
  config    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([enabled])
  @@index([type])
}

model OpencodeConfig {
  id                       String    @id
  userId                   String
  name                     String
  baseURL                  String    @default("http://localhost:54321")
  description              String?
  isActive                 Boolean   @default(true)
  mcpServers               String?
  keybinds                 String?
  modelPreferences         String?
  projectUploadDir         String?
  taskDescription          String?
  workflowConfig           String?
  customSystemPrompt       String?
  claudemdPath             String?
  resumeSession            Boolean   @default(false)
  permissionMode           String?
  settingSources           String?
  progressQuestion         String?
  skillOutputTemplate      String?
  claudemdTemplate         String?
  maxConcurrentEvaluations Int       @default(3)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime
  defaultToolPermissions   String?
  User                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Project                  Project[]

  @@index([userId])
}

model Permission {
  id          String   @id
  name        String   @unique
  description String?
  module      String
  action      String
  resource    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Role        Role[]

  @@unique([module, action])
  @@index([module])
}

model Plugin {
  id          String   @id
  name        String   @unique
  displayName String
  description String
  version     String
  author      String
  type        String
  status      String   @default("inactive")
  config      String?
  pluginPath  String?
  isEnabled   Boolean  @default(false)
  isBuiltin   Boolean  @default(false)
  icon        String?
  homepage    String?
  repository  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([isEnabled])
  @@index([status])
  @@index([type])
  @@index([name])
}

model Project {
  id                        String                      @id
  userId                    String
  configId                  String?
  name                      String
  displayName               String?
  fullPath                  String?
  description               String?
  projectPath               String?
  status                    String                      @default("idle")
  isPublic                  Boolean                     @default(false) // 是否公开共享
  environmentUrl            String?
  adminUsername             String?
  adminPassword             String?
  normalUsername            String?
  normalPassword            String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  techStack                 String?
  AnalysisReport            AnalysisReport[]
  CodeKnowledge             CodeKnowledge[]
  DataFlow                  DataFlow[]
  EvaluationSession         EvaluationSession[]
  McpServerConfig           McpServerConfig[]
  OpencodeConfig            OpencodeConfig?             @relation(fields: [configId], references: [id])
  User                      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ProjectFile               ProjectFile[]
  ProjectStructure          ProjectStructure?
  ScanTask                  ScanTask[]
  SessionMeta               SessionMeta?
  SkillExecution            SkillExecution[]
  ToolPermission            ToolPermission[]
  Vulnerability             Vulnerability[]
  SkillVulnerabilityMapping SkillVulnerabilityMapping[] // 新增：Skill漏洞映射关联

  // 新增关联
  Report Report[]

  @@index([name])
  @@index([status])
  @@index([configId])
  @@index([userId])
}

model ProjectFile {
  id         String   @id
  projectId  String
  fileName   String
  filePath   String
  fileSize   Float
  fileType   String
  uploadedAt DateTime @default(now())
  Project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectStructure {
  id            String    @id
  projectId     String    @unique
  structure     String
  fileCount     Int       @default(0)
  codeCount     Int       @default(0)
  languageStats String
  status        String    @default("pending")
  analyzedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Role {
  id          String       @id
  name        String       @unique
  description String?
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  UserRole    UserRole[]
  Permission  Permission[]

  @@index([name])
}

model ScanReport {
  id         String   @id
  scanTaskId String
  projectId  String
  summary    String
  details    String
  format     String   @default("json")
  createdAt  DateTime @default(now())
  ScanTask   ScanTask @relation(fields: [scanTaskId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([scanTaskId])
}

model ScanTask {
  id              String           @id
  projectId       String
  userId          String
  name            String
  description     String?
  skillIds        String
  schedule        String?
  nextRunAt       DateTime?
  status          String           @default("pending")
  startedAt       DateTime?
  completedAt     DateTime?
  progress        Int              @default(0)
  currentSkill    String?
  totalSkills     Int              @default(0)
  completedSkills Int              @default(0)
  findingsCount   Int              @default(0)
  error           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  ScanReport      ScanReport[]
  Project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  SkillExecution  SkillExecution[]

  @@index([userId, status])
  @@index([createdAt])
  @@index([status])
  @@index([projectId])
}

model SessionMessage {
  id                  String            @id
  evaluationSessionId String
  role                String
  content             String
  metadata            String?
  createdAt           DateTime          @default(now())
  EvaluationSession   EvaluationSession @relation(fields: [evaluationSessionId], references: [id], onDelete: Cascade)

  @@index([evaluationSessionId])
}

model SessionMeta {
  id             String   @id
  projectId      String   @unique
  total          Int      @default(0)
  hasMore        Boolean  @default(false)
  claudeCount    Int      @default(0)
  cursorCount    Int      @default(0)
  codexCount     Int      @default(0)
  geminiCount    Int      @default(0)
  runningCount   Int      @default(0)
  completedCount Int      @default(0)
  failedCount    Int      @default(0)
  updatedAt      DateTime
  Project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Skill {
  id                     String   @id
  userId                 String?
  name                   String
  displayName            String
  description            String
  severity               String?
  content                String
  cwe                    String?
  isActive               Boolean  @default(true)
  isBuiltin              Boolean  @default(false)
  isPublic               Boolean  @default(false)
  version                Int      @default(1)
  parentId               String?
  isLatest               Boolean  @default(true)
  successRate            Float?
  avgDuration            Int?
  execCount              Int      @default(0)
  referenceCount         Int      @default(0)
  vulnerabilityCount     Int      @default(0)
  successExecCount       Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime
  techStackId            String?
  vulnerabilityPatternId String?

  // ===== 关联关系 =====
  User                                                   User?                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  Skill                                                  Skill?                      @relation("SkillToSkill", fields: [parentId], references: [id])
  other_Skill                                            Skill[]                     @relation("SkillToSkill")
  TechStackOption                                        TechStackOption?            @relation(fields: [techStackId], references: [id])
  VulnerabilityPattern                                   VulnerabilityPattern?       @relation(fields: [vulnerabilityPatternId], references: [id])
  SkillEvolution                                         SkillEvolution[]
  SkillExecution                                         SkillExecution[]
  SkillMergeRecord_SkillMergeRecord_sourceSkillIdToSkill SkillMergeRecord[]          @relation("SkillMergeRecord_sourceSkillIdToSkill")
  SkillMergeRecord_SkillMergeRecord_targetSkillIdToSkill SkillMergeRecord[]          @relation("SkillMergeRecord_targetSkillIdToSkill")
  SkillNewImpactAnalysis                                 SkillNewImpactAnalysis[]
  SkillObservationLog                                    SkillObservationLog[]
  SkillObservationStats                                  SkillObservationStats?
  SkillAnalysis                                          SkillAnalysis[]
  SkillDuplicateGroupMember                              SkillDuplicateGroupMember[]
  SkillVulnerabilityMapping                              SkillVulnerabilityMapping[]

  @@unique([userId, name])
  @@index([userId])
  @@index([name])
  @@index([isLatest])
  @@index([version])
  @@index([isActive])
  @@index([isPublic])
  @@index([techStackId])
  @@index([vulnerabilityPatternId])
}

model SkillEvolution {
  id          String   @id
  skillId     String
  fromVersion Int
  toVersion   Int
  changeType  String
  changeDesc  String
  beforeData  String
  afterData   String
  reason      String
  beforeRate  Float?
  afterRate   Float?
  createdAt   DateTime @default(now())
  Skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([skillId])
}

model SkillExecution {
  id                 String             @id
  skillId            String
  projectId          String
  evaluationId       String? // 关联评估会话
  scanTaskId         String?
  input              String
  output             String?
  status             String             @default("pending")
  startedAt          DateTime?

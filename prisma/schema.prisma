generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AgentDefinition {
  id              String            @id
  userId          String?
  name            String            @unique
  displayName     String
  description     String?
  category        String
  modelConfigId   String?
  model           String
  systemPrompt    String?
  allowedTools    String?
  skills          String?
  mcpServers      String?
  isActive        Boolean           @default(true)
  isBuiltin       Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  User            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ModelConfig     ModelConfig?      @relation(fields: [modelConfigId], references: [id])
  AgentTeam       AgentTeam[]
  AgentTeamMember AgentTeamMember[]

  @@index([name])
  @@index([category])
  @@index([isActive])
}

model AgentMemberExecution {
  id                 String             @id
  teamExecutionId    String
  memberId           String
  status             String             @default("pending")
  startedAt          DateTime?
  completedAt        DateTime?
  inputTokens        Int                @default(0)
  outputTokens       Int                @default(0)
  createdAt          DateTime           @default(now())
  AgentTeamExecution AgentTeamExecution @relation(fields: [teamExecutionId], references: [id], onDelete: Cascade)
  AgentTeamMember    AgentTeamMember    @relation(fields: [memberId], references: [id])

  @@index([teamExecutionId])
  @@index([memberId])
  @@index([status])
}

model AgentTeam {
  id                 String               @id
  userId             String
  name               String
  description        String?
  leadAgentId        String
  taskStrategy       String?              @default("parallel")
  maxTeammates       Int                  @default(5)
  status             String               @default("idle")
  ralphConfig        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  User               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  AgentDefinition    AgentDefinition      @relation(fields: [leadAgentId], references: [id], onDelete: Cascade)
  AgentTeamExecution AgentTeamExecution[]
  AgentTeamMember    AgentTeamMember[]
  EvaluationSession  EvaluationSession[]

  @@index([userId])
  @@index([status])
  @@index([leadAgentId])
}

model AgentTeamExecution {
  id                   String                 @id
  teamId               String
  evaluationId         String?
  status               String                 @default("pending")
  startedAt            DateTime?
  completedAt          DateTime?
  totalInputTokens     Int                    @default(0)
  totalOutputTokens    Int                    @default(0)
  createdAt            DateTime               @default(now())
  AgentMemberExecution AgentMemberExecution[]
  AgentTeam            AgentTeam              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  EvaluationSession    EvaluationSession?     @relation(fields: [evaluationId], references: [id])

  @@index([teamId])
  @@index([evaluationId])
  @@index([status])
}

model AgentTeamMember {
  id                   String                 @id
  teamId               String
  agentId              String
  role                 String
  overrideModel        String?
  overrideTools        String?
  createdAt            DateTime               @default(now())
  AgentMemberExecution AgentMemberExecution[]
  AgentTeam            AgentTeam              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  AgentDefinition      AgentDefinition        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([agentId])
}

model AlertInstance {
  id               String    @id
  ruleId           String
  ruleName         String
  severity         String
  status           String    @default("active")
  message          String
  value            Float
  threshold        Float
  triggeredAt      DateTime  @default(now())
  resolvedAt       DateTime?
  acknowledgedAt   DateTime?
  acknowledgedBy   String?
  details          String?
  notifiedChannels String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  AlertRule        AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([triggeredAt])
  @@index([severity])
  @@index([status])
  @@index([ruleId])
}

model AlertRule {
  id                   String          @id
  name                 String          @unique
  description          String?
  metricType           String
  condition            String
  severity             String          @default("medium")
  enabled              Boolean         @default(true)
  cooldownPeriod       Int             @default(300)
  notificationChannels String
  tags                 String?
  lastTriggeredAt      DateTime?
  triggerCount         Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime
  AlertInstance        AlertInstance[]

  @@index([severity])
  @@index([enabled])
  @@index([metricType])
}

model AuditLog {
  id        String   @id
  userId    String?
  action    String
  resource  String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([createdAt])
  @@index([action])
  @@index([userId])
}

model AutonomousEvolutionExperience {
  id              String    @id
  title           String
  errorCategory   String
  errorPatterns   String
  sourceModel     String
  sourceSessionId String
  sourceProjectId String?
  attemptSequence String
  directSolution  String
  lesson          String
  isInjected      Boolean   @default(false)
  injectedAt      DateTime?
  hitCount        Int       @default(1)
  savedAttempts   Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime

  @@index([hitCount])
  @@index([sourceModel])
  @@index([isInjected])
  @@index([errorCategory])
}

model AutonomousEvolutionRunLog {
  id           String    @id
  mode         String
  trigger      String    @default("manual")
  scanned      Int       @default(0)
  skipped      Int       @default(0)
  newFiles     Int       @default(0)
  sequences    Int       @default(0)
  created      Int       @default(0)
  merged       Int       @default(0)
  status       String    @default("running")
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([trigger])
  @@index([startedAt])
}

model CodeKnowledge {
  id         String   @id
  projectId  String
  entityType String
  name       String
  filePath   String
  lineStart  Int
  lineEnd    Int?
  parentId   String?
  calls      String?
  calledBy   String?
  signature  String?
  docstring  String?
  code       String?
  summary    String?
  riskScore  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([name])
  @@index([entityType])
  @@index([projectId])
}

model DataFlow {
  id          String   @id
  projectId   String
  sourceId    String
  sinkId      String
  sourceName  String
  sinkName    String
  path        String
  isUserInput Boolean  @default(false)
  isSensitive Boolean  @default(false)
  createdAt   DateTime @default(now())
  Project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([sinkId])
  @@index([sourceId])
  @@index([projectId])
}

model EvaluationIteration {
  id                   String            @id
  evaluationSessionId  String
  iterationNumber      Int
  status               String            @default("pending")
  startedAt            DateTime?
  completedAt          DateTime?
  duration             Int?
  responseText         String?
  inputTokens          Int?
  outputTokens         Int?
  toolCallCount        Int               @default(0)
  verificationComplete Boolean?
  verificationReason   String?
  errorMessage         String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime
  EvaluationSession    EvaluationSession @relation(fields: [evaluationSessionId], references: [id], onDelete: Cascade)

  @@unique([evaluationSessionId, iterationNumber])
  @@index([iterationNumber])
  @@index([status])
  @@index([evaluationSessionId])
}

model EvaluationResult {
  id                String            @id
  evaluationId      String            @unique
  totalVulns        Int               @default(0)
  criticalCount     Int               @default(0)
  highCount         Int               @default(0)
  mediumCount       Int               @default(0)
  lowCount          Int               @default(0)
  infoCount         Int               @default(0)
  skillsUsed        String?
  rawReport         String?
  createdAt         DateTime          @default(now())
  EvaluationSession EvaluationSession @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
}

model EvaluationSession {
  id                  String                @id
  projectId           String
  workflowId          String?
  agentTeamId         String?
  modelConfigId       String?
  opencodeSessionId   String?               @unique
  provider            String                @default("claude")
  title               String?
  summary             String?
  messageCount        Int                   @default(0)
  lastActivity        DateTime?             @default(now())
  port                Int?
  status              String                @default("running")
  startedAt           DateTime              @default(now())
  completedAt         DateTime?
  errorMessage        String?
  modelName           String?
  providerType        String?
  todoList            String?
  totalInputTokens    Int                   @default(0)
  totalOutputTokens   Int                   @default(0)
  totalTokens         Int                   @default(0)
  estimatedCost       Float?
  AgentTeamExecution  AgentTeamExecution[]
  EvaluationIteration EvaluationIteration[]
  EvaluationResult    EvaluationResult?
  Project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  AgentTeam           AgentTeam?            @relation(fields: [agentTeamId], references: [id])
  ModelConfig         ModelConfig?          @relation(fields: [modelConfigId], references: [id])
  NodeExecution       NodeExecution[]
  SessionMessage      SessionMessage[]
  TokenUsage          TokenUsage[]
  Vulnerability       Vulnerability[]

  @@index([projectId])
  @@index([agentTeamId])
  @@index([workflowId])
  @@index([modelConfigId])
  @@index([opencodeSessionId])
  @@index([status])
  @@index([provider])
  @@index([lastActivity])
}

model ExpectedOutputTemplate {
  id          String   @id
  name        String   @unique
  displayName String
  description String
  category    String
  template    String
  example     String?
  isActive    Boolean  @default(true)
  isBuiltin   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([isActive])
  @@index([category])
  @@index([name])
}

model ExperienceUsageLog {
  id           String   @id
  experienceId String
  evaluationId String
  projectId    String?
  source       String   @default("pre_injected")
  usedAt       DateTime @default(now())

  @@index([experienceId])
  @@index([evaluationId])
  @@index([usedAt])
  @@index([source])
}

model LogFileRecord {
  id            String   @id
  filePath      String   @unique
  fileHash      String
  processedAt   DateTime @default(now())
  sequenceCount Int      @default(0)

  @@index([filePath])
}

model McpServerConfig {
  id        String   @id
  userId    String
  projectId String?
  name      String
  type      String
  command   String?
  args      String?
  url       String?
  env       String?
  isEnabled Boolean  @default(true)
  autoStart Boolean  @default(false)
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime
  Project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isShared])
  @@index([name])
  @@index([projectId])
  @@index([userId])
}

model ModelConfig {
  id                String              @id
  userId            String?
  name              String
  providerType      String              @default("openai")
  apiBaseUrl        String
  apiKey            String
  models            String
  routeType         String?
  isActive          Boolean             @default(true)
  isDefault         Boolean             @default(false)
  isPublic          Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  AgentDefinition   AgentDefinition[]
  EvaluationSession EvaluationSession[]
  User              User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([routeType])
  @@index([providerType])
  @@index([isPublic])
  @@index([isDefault])
  @@index([isActive])
  @@index([userId])
}

model NodeExecution {
  id                  String            @id
  evaluationSessionId String
  workflowNodeId      String
  nodeLabel           String
  nodeType            String
  status              String            @default("pending")
  startedAt           DateTime?
  completedAt         DateTime?
  order               Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime
  EvaluationSession   EvaluationSession @relation(fields: [evaluationSessionId], references: [id], onDelete: Cascade)

  @@unique([evaluationSessionId, workflowNodeId])
  @@index([status])
  @@index([workflowNodeId])
  @@index([evaluationSessionId])
}

model NotificationChannel {
  id        String   @id
  name      String   @unique
  type      String
  config    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([enabled])
  @@index([type])
}

model OpencodeConfig {
  id                       String    @id
  userId                   String
  name                     String
  baseURL                  String    @default("http://localhost:54321")
  description              String?
  isActive                 Boolean   @default(true)
  mcpServers               String?
  keybinds                 String?
  modelPreferences         String?
  projectUploadDir         String?
  taskDescription          String?
  workflowConfig           String?
  customSystemPrompt       String?
  claudemdPath             String?
  resumeSession            Boolean   @default(false)
  permissionMode           String?
  settingSources           String?
  progressQuestion         String?
  skillOutputTemplate      String?
  claudemdTemplate         String?
  maxConcurrentEvaluations Int       @default(3)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime
  defaultToolPermissions   String?
  User                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Project                  Project[]

  @@index([userId])
}

model Permission {
  id          String   @id
  name        String   @unique
  description String?
  module      String
  action      String
  resource    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Role        Role[]

  @@unique([module, action])
  @@index([module])
}

model Plugin {
  id          String   @id
  name        String   @unique
  displayName String
  description String
  version     String
  author      String
  type        String
  status      String   @default("inactive")
  config      String?
  pluginPath  String?
  isEnabled   Boolean  @default(false)
  isBuiltin   Boolean  @default(false)
  icon        String?
  homepage    String?
  repository  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([isEnabled])
  @@index([status])
  @@index([type])
  @@index([name])
}

model Project {
  id                String              @id
  userId            String
  configId          String?
  name              String
  displayName       String?
  fullPath          String?
  description       String?
  projectPath       String?
  status            String              @default("idle")
  environmentUrl    String?
  adminUsername     String?
  adminPassword     String?
  normalUsername    String?
  normalPassword    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  techStack         String?
  CodeKnowledge     CodeKnowledge[]
  DataFlow          DataFlow[]
  EvaluationSession EvaluationSession[]
  McpServerConfig   McpServerConfig[]
  OpencodeConfig    OpencodeConfig?     @relation(fields: [configId], references: [id])
  User              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ProjectFile       ProjectFile[]
  ProjectStructure  ProjectStructure?
  ScanTask          ScanTask[]
  SessionMeta       SessionMeta?
  SkillExecution    SkillExecution[]
  ToolPermission    ToolPermission[]
  Vulnerability     Vulnerability[]

  @@index([name])
  @@index([status])
  @@index([configId])
  @@index([userId])
}

model ProjectFile {
  id         String   @id
  projectId  String
  fileName   String
  filePath   String
  fileSize   Float
  fileType   String
  uploadedAt DateTime @default(now())
  Project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectStructure {
  id            String    @id
  projectId     String    @unique
  structure     String
  fileCount     Int       @default(0)
  codeCount     Int       @default(0)
  languageStats String
  status        String    @default("pending")
  analyzedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Role {
  id          String       @id
  name        String       @unique
  description String?
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  UserRole    UserRole[]
  Permission  Permission[]

  @@index([name])
}

model ScanReport {
  id         String   @id
  scanTaskId String
  projectId  String
  summary    String
  details    String
  format     String   @default("json")
  createdAt  DateTime @default(now())
  ScanTask   ScanTask @relation(fields: [scanTaskId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([scanTaskId])
}

model ScanTask {
  id              String           @id
  projectId       String
  userId          String
  name            String
  description     String?
  skillIds        String
  schedule        String?
  nextRunAt       DateTime?
  status          String           @default("pending")
  startedAt       DateTime?
  completedAt     DateTime?
  progress        Int              @default(0)
  currentSkill    String?
  totalSkills     Int              @default(0)
  completedSkills Int              @default(0)
  findingsCount   Int              @default(0)
  error           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  ScanReport      ScanReport[]
  Project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  SkillExecution  SkillExecution[]

  @@index([userId, status])
  @@index([createdAt])
  @@index([status])
  @@index([projectId])
}

model SessionMessage {
  id                  String            @id
  evaluationSessionId String
  role                String
  content             String
  metadata            String?
  createdAt           DateTime          @default(now())
  EvaluationSession   EvaluationSession @relation(fields: [evaluationSessionId], references: [id], onDelete: Cascade)

  @@index([evaluationSessionId])
}

model SessionMeta {
  id             String   @id
  projectId      String   @unique
  total          Int      @default(0)
  hasMore        Boolean  @default(false)
  claudeCount    Int      @default(0)
  cursorCount    Int      @default(0)
  codexCount     Int      @default(0)
  geminiCount    Int      @default(0)
  runningCount   Int      @default(0)
  completedCount Int      @default(0)
  failedCount    Int      @default(0)
  updatedAt      DateTime
  Project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Skill {
  id                                                     String                   @id
  userId                                                 String?
  name                                                   String
  displayName                                            String
  description                                            String
  category                                               String
  techStack                                              String?
  severity                                               String?
  content                                                String
  cwe                                                    String?
  isActive                                               Boolean                  @default(true)
  isBuiltin                                              Boolean                  @default(false)
  isPublic                                               Boolean                  @default(false)
  version                                                Int                      @default(1)
  parentId                                               String?
  isLatest                                               Boolean                  @default(true)
  successRate                                            Float?
  avgDuration                                            Int?
  execCount                                              Int                      @default(0)
  referenceCount                                         Int                      @default(0)
  vulnerabilityCount                                     Int                      @default(0)
  createdAt                                              DateTime                 @default(now())
  updatedAt                                              DateTime
  User                                                   User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  Skill                                                  Skill?                   @relation("SkillToSkill", fields: [parentId], references: [id])
  other_Skill                                            Skill[]                  @relation("SkillToSkill")
  SkillEvolution                                         SkillEvolution[]
  SkillExecution                                         SkillExecution[]
  SkillMergeRecord_SkillMergeRecord_sourceSkillIdToSkill SkillMergeRecord[]       @relation("SkillMergeRecord_sourceSkillIdToSkill")
  SkillMergeRecord_SkillMergeRecord_targetSkillIdToSkill SkillMergeRecord[]       @relation("SkillMergeRecord_targetSkillIdToSkill")
  SkillNewImpactAnalysis                                 SkillNewImpactAnalysis[]
  SkillObservationLog                                    SkillObservationLog[]
  SkillObservationStats                                  SkillObservationStats?

  @@unique([userId, name])
  @@index([userId])
  @@index([name])
  @@index([isLatest])
  @@index([version])
  @@index([category])
  @@index([isActive])
  @@index([isPublic])
}

model SkillEvolution {
  id          String   @id
  skillId     String
  fromVersion Int
  toVersion   Int
  changeType  String
  changeDesc  String
  beforeData  String
  afterData   String
  reason      String
  beforeRate  Float?
  afterRate   Float?
  createdAt   DateTime @default(now())
  Skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([skillId])
}

model SkillExecution {
  id                 String          @id
  skillId            String
  projectId          String
  scanTaskId         String?
  input              String
  output             String?
  status             String          @default("pending")
  startedAt          DateTime?
  completedAt        DateTime?
  duration           Int?
  error              String?
  findingsCount      Int             @default(0)
  confirmedCount     Int             @default(0)
  falsePositiveCount Int             @default(0)
  inputTokens        Int?
  outputTokens       Int?
  createdAt          DateTime        @default(now())
  ScanTask           ScanTask?       @relation(fields: [scanTaskId], references: [id])
  Project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Skill              Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  Vulnerability      Vulnerability[]

  @@index([skillId, status])
  @@index([projectId, status])
  @@index([createdAt])
  @@index([status])
  @@index([projectId])
  @@index([skillId])
}

model SkillGovernanceConfig {
  id             String   @id
  configKey      String   @unique
  thresholdValue Float
  configValue    String?
  description    String?
  isActive       Boolean  @default(true)
  isBuiltin      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime

  @@index([configKey])
  @@index([isActive])
}

model SkillMergeRecord {
  id                                          String    @id
  sourceSkillId                               String
  targetSkillId                               String
  mergeReason                                 String
  mergeDetails                                String?
  status                                      String    @default("pending")
  approvedBy                                  String?
  approvedAt                                  DateTime?
  completedAt                                 DateTime?
  revertedAt                                  DateTime?
  sourceOwnerConsent                          Boolean   @default(false)
  targetOwnerConsent                          Boolean   @default(false)
  mergedBy                                    String?
  mergedAt                                    DateTime?
  createdAt                                   DateTime  @default(now())
  updatedAt                                   DateTime
  Skill_SkillMergeRecord_sourceSkillIdToSkill Skill     @relation("SkillMergeRecord_sourceSkillIdToSkill", fields: [sourceSkillId], references: [id])
  Skill_SkillMergeRecord_targetSkillIdToSkill Skill     @relation("SkillMergeRecord_targetSkillIdToSkill", fields: [targetSkillId], references: [id])

  @@index([sourceSkillId])
  @@index([targetSkillId])
  @@index([status])
  @@index([createdAt])
  @@index([sourceSkillId, targetSkillId])
}

model SkillNewImpactAnalysis {
  id                   String    @id
  skillId              String
  similarSkills        String?
  overlapScore         Float?
  affectedWorkflows    String?
  recommendation       String?
  recommendationReason String?
  status               String    @default("pending")
  analyzedAt           DateTime?
  actionedAt           DateTime?
  createdBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime
  Skill                Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@index([overlapScore])
  @@index([status])
  @@index([createdAt])
}

model SkillObservationLog {
  id             String    @id
  skillId        String
  triggerType    String
  triggerContext String?
  matches        String?
  issues         String?
  severity       String    @default("info")
  status         String    @default("pending")
  resolvedAt     DateTime?
  resolvedBy     String?
  resolution     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  Skill          Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@index([triggerType])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
  @@index([skillId, createdAt])
}

model SkillObservationStats {
  id                String    @id
  skillId           String    @unique
  totalObservations Int       @default(0)
  warningCount      Int       @default(0)
  matchCount        Int       @default(0)
  overlapCount      Int       @default(0)
  matchRate         Float?
  warningRate       Float?
  avgResponseTime   Int?
  avgMatchScore     Float?
  firstObservedAt   DateTime?
  lastObservedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  Skill             Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@index([warningCount])
  @@index([matchRate])
}

model SkillPrediction {
  id                String   @id
  userId            String
  workflowId        String?
  taskName          String
  taskDescription   String
  matches           String
  method            String
  workflowTechStack String?
  matchCount        Int      @default(0)
  createdAt         DateTime @default(now())
  User              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workflowId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model SkillPredictionTask {
  id                String    @id
  userId            String
  workflowId        String?
  taskName          String
  taskDescription   String
  topK              Int       @default(5)
  status            String    @default("pending")
  progress          Int       @default(0)
  errorMessage      String?
  matches           String?
  method            String?
  matchCount        Int?
  startedAt         DateTime?
  completedAt       DateTime?
  duration          Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  nodeId            String?
  governanceWarning String?
  User              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workflowId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
  @@index([nodeId])
  @@index([workflowId, nodeId])
}

model SystemConfig {
  id          String   @id
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([key])
}

model SystemMetric {
  id         String   @id
  name       String
  type       String
  value      Float
  tags       String?
  recordedAt DateTime @default(now())

  @@index([recordedAt])
  @@index([name])
  @@index([type])
}

model TechStackOption {
  id          String   @id
  name        String   @unique
  category    String
  description String?
  isActive    Boolean  @default(true)
  isBuiltin   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([isActive])
  @@index([category])
  @@index([name])
}

model TokenUsage {
  id                 String             @id
  evaluationId       String?
  projectId          String?
  apiProvider        String
  modelName          String?
  callType           String
  inputTokens        Int                @default(0)
  outputTokens       Int                @default(0)
  totalTokens        Int                @default(0)
  cachedTokens       Int?
  requestPreview     String?
  responsePreview    String?
  requestStartedAt   DateTime           @default(now())
  requestCompletedAt DateTime?
  durationMs         Int?
  estimatedCost      Float?
  status             String             @default("success")
  errorMessage       String?
  createdAt          DateTime           @default(now())
  EvaluationSession  EvaluationSession? @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([evaluationId, createdAt])
  @@index([createdAt])
  @@index([modelName])
  @@index([apiProvider])
  @@index([projectId])
  @@index([evaluationId])
}

model Tool {
  id                 String   @id
  name               String   @unique
  displayName        String
  description        String
  category           String
  parameters         String
  executor           String
  executorConfig     String?
  requiresPermission Boolean  @default(false)
  allowedInSandbox   Boolean  @default(true)
  timeout            Int      @default(600000)
  isActive           Boolean  @default(true)
  isBuiltin          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime

  @@index([isActive])
  @@index([category])
}

model ToolPermission {
  id          String   @id
  projectId   String
  toolPattern String
  permission  String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, toolPattern])
  @@index([projectId])
}

model User {
  id                  String                @id
  email               String                @unique
  username            String                @unique
  passwordHash        String
  name                String?
  avatar              String?
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  AgentDefinition     AgentDefinition[]
  AgentTeam           AgentTeam[]
  McpServerConfig     McpServerConfig[]
  ModelConfig         ModelConfig[]
  OpencodeConfig      OpencodeConfig[]
  Project             Project[]
  Skill               Skill[]
  SkillPrediction     SkillPrediction[]
  SkillPredictionTask SkillPredictionTask[]
  UserRole            UserRole[]

  @@index([username])
  @@index([email])
}

model UserRole {
  id        String   @id
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  Role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([userId])
}

model Vulnerability {
  id                String             @id
  projectId         String
  evaluationId      String?
  skillExecutionId  String?
  title             String
  description       String
  type              String
  cwe               String?
  severity          String
  skill             String?
  filePath          String?
  lineStart         Int?
  lineEnd           Int?
  codeSnippet       String?
  details           String?
  aiAnalysis        String?
  fixSuggestion     String?
  status            String             @default("new")
  confirmedBy       String?
  confirmedAt       DateTime?
  fixedBy           String?
  fixedAt           DateTime?
  verifiedBy        String?
  verifiedAt        DateTime?
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  SkillExecution    SkillExecution?    @relation(fields: [skillExecutionId], references: [id])
  EvaluationSession EvaluationSession? @relation(fields: [evaluationId], references: [id])
  Project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([severity, status])
  @@index([projectId, status])
  @@index([createdAt])
  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([evaluationId])
  @@index([projectId])
}

model VulnerabilityPattern {
  id                String   @id
  name              String   @unique
  displayName       String
  description       String
  category          String
  cwe               String?
  cve               String?
  patterns          String
  languages         String
  exampleVulnerable String?
  exampleFixed      String?
  fixGuidance       String?
  isActive          Boolean  @default(true)
  isBuiltin         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime

  @@index([isActive])
  @@index([category])
}

# /home/icsl/Shared-workspace - Environment variables
#数据库配置
DATABASE_URL=postgresql://postgres:Huawei12%23%24@172.31.23.182:5432/luyuxin?connection_limit=20&pool_timeout=60&connect_timeout=10&socket_timeout=60&statement_timeout=60000
# DATABASE_URL=postgresql://postgres:Huawei12%23%24@172.31.23.182:5432/ai4sec?connection_limit=5&pool_timeout=10&connect_timeout=10&socket_timeout=60&statement_timeout=60000
JWT_SECRET=your-secret-key-change-in-production
NODE_ENV=development
ADMIN_SEED_PASSWORD=admin123

# 上传文件大小限制（MB）
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=500
# CodeSwarm Worker 回调地址（Worker 网络需能访问）
NEXT_PUBLIC_BASE_URL=http://172.31.30.81:3000

# Redis 配置 - CodeSwarm 调度队列
REDIS_URL=redis://172.31.23.181:6379/3


# NFS 共享工作区配置
NFS_MOUNT_PATH=/mnt/luyuxin/ai4_worker
SHARED_WORKSPACE_PATH=/mnt/luyuxin/ai4_worker



# Claude SDK MCP 超时配置（毫秒）- 10 分钟
CLAUDE_CODE_STREAM_CLOSE_TIMEOUT=600000


# Skills_Gitea 配置 - skill 文件存储（Git 同步）
# Gitea 服务地址
SKILLS_GITEA_URL=http://172.31.30.81:30030
# Gitea API Token (需要 repo write 权限)
SKILLS_GITEA_TOKEN=2a0eb308a797b6485d76ca35144f16224b2e7fb4
# 仓库所有者
SKILLS_GITEA_REPO_OWNER=wx1470671
# 仓库名称
SKILLS_GITEA_REPO_NAME=skill-test
# 分支名称
SKILLS_GITEA_BRANCH=main
# 本地 Git 同步文件夹（可选，默认 ./skill_management）
SKILL_LOCAL_PATH=./skill_management

# MinIO 配置 - Codedmap DB 文件存储
MINIO_ENDPOINT=172.31.23.181
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=codedmap-dbs
MINIO_USE_SSL=false

# MinIO 漏洞文件存储桶（统一存储报告和原始文件）
MINIO_VULN_FILE_BUCKET=vuln-file

# Web 应用端口（默认 3000，如需修改请在此设置）
# Worker 的 PORT=8090 已在其启动命令中硬编码，无需在此配置
PORT=3000

# Gitea 组织仓库配置 - AgentHarness 存储
GITEA_ORG_URL=http://172.31.30.81:30030
GITEA_ORG_TOKEN=aeb4b6fa831bd49a8fb84341479d51f434a55f4f
GITEA_ORG_NAME=icsl-test
AGENT_HARNESS_LOCAL_PATH=./AgentHarness

# 任务文件清理配置
TASK_CLEANUP_RETENTION_DAYS=30
TASK_CLEANUP_HOUR=3

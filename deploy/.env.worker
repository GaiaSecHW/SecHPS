# ============================================================================
# CodeSwarm Worker 环境变量配置
# ============================================================================
# 开发模式下 Worker 直接读取此文件（通过 --env-file=../../.env）
# 生产 Docker 部署时通过 docker-compose.yml 的 environment 字段注入
# 代码中实际读取的变量列表见下方，所有变量都有默认值，可按需覆盖
# ============================================================================
# 注意：docker run --env-file 不支持行内注释，# 会被当作值的一部分
#       所以变量赋值行不能加 # 注释，注释只能写在独立行
# ============================================================================

# ---- Worker 核心配置 ----
NODE_ID=worker-01
PORT=8090
MAX_CONCURRENT=5
ORCHESTRATOR_URL=http://172.31.23.187:3000
WORKER_ADDRESS=172.31.23.187:8090

# ---- CodeMap 知识图谱引擎 ----
CODEDMAP_HOME=/opt/codedmap
JOERN_HOME=/opt/joern-cli
JAVA_HOME=/opt/jdk-21

# ---- MinIO 对象存储（codedmap DB 缓存）----
MINIO_ENDPOINT=172.31.23.181
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=codedmap-dbs
MINIO_USE_SSL=false
OPENCODE_DISABLE_MODELS_FETCH=true
IS_SANDBOX=1
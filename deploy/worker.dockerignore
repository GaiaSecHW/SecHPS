# .dockerignore for SecHPS Worker image
# Build: docker build -f Dockerfile.worker .
#
# Worker needs codeswarm-service/ (worker source) in build context,
# but does NOT need src/, prisma/, or other server-only code.

# === Rebuilt in Docker ===
.next
node_modules

# === Version control ===
.git
.gitignore

# === IDE ===
.idea
.vscode
*.swp
.claude/
.omc/

# === Secrets ===
.env
.env.local
.env.example

# === Runtime data ===
data/
uploads/
skill_management/
AgentHarness/
skills.clone/
test-skills-output/

# === Logs ===
*.log
app.log
worker.log

# === Scripts (not needed for worker) ===
scripts/

# === Dev/test artifacts ===
docs/
test-*.js
test-*.ts
test-*.py
test-*.cjs
test-*.mjs
test-project/
test-results/
test-outputs/

# === SecHPS Server code (not needed for worker) ===
src/
prisma/

# === Misc ===
/*.md
*.zip
*.tar.gz
*.7z
*.db
dev.db
prod_dev.db
tsconfig.tsbuildinfo
temp-*
session-ses_*.md
Dockerfile.server
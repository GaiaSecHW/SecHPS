  "recommended_agents_detail": [
    {
      "agent": "audit-spec-auth-access",
      "blocking": true,
      "priority": "critical",
      "reason": "70+ 权限点, 5 种角色, JWT/Cookie/API Key 三种认证方式并行, 多租户隔离逻辑, 大量端点需权限校验. D2认证绕过和D3权限提升风险高."
    },
    {
      "agent": "audit-spec-injection",
      "blocking": true,
      "priority": "critical",
      "reason": "Prisma ORM + raw SQL 查询 (fetchPermissionsPaginated), 文件路径拼接, 插件上传解压, MCP子进程调用, 终端命令执行, Gitea命令执行, DB轮询模式SQL注入风险."
    },
    {
      "agent": "audit-spec-file-ssrf",
      "blocking": false,
      "priority": "high",
      "reason": "文件读写 API (路径遍历防护只做repace ..), 插件上传解压(ZIP/TarGz), 项目发现扫描, MCP远程连接, CodeSwarm Worker外部通信, webhook URL回调."
    },
    {
      "agent": "audit-spec-config-crypto",
      "blocking": false,
      "priority": "high",
      "reason": "JWT_SECRET环境变量, API Key哈希存储, ModelConfig含API Key, .env含DB密码, 配置导出/导入接口, 管理员端点暴露."
    },
    {
      "agent": "audit-spec-rce",
      "blocking": false,
      "priority": "high",
      "reason": "MCP Stdio子进程spawn, 终端(node-pty), 插件安装执行, 技能执行, Agent执行, 代码分析, 脚本执行, deserialize操作."
    },
    {
      "agent": "audit-spec-llm",
      "blocking": false,
      "priority": "high",
      "reason": "AI Agent聊天/执行, 多模型路由 (Claude/OpenAI/Gemini), MCP工具调用, Skill系统, Prompt注入风险, 租户隔离."
    },
    {
      "agent": "audit-spec-business-logic",
      "blocking": false,
      "priority": "medium",
      "reason": "多租户数据隔离, 工作流状态机, 评估执行流程, Token统计计费, 技能进化系统, 自主进化逻辑."
    },
    {
      "agent": "audit-spec-client",
      "blocking": false,
      "priority": "medium",
      "reason": "22个Dashboard页面, 多组件库, SWR数据请求, React 19客户端组件, 权限UI显示逻辑."
    },
    {
      "agent": "audit-spec-dos",
      "blocking": false,
      "priority": "medium",
      "reason": "文件上传大小限制, 分页查询, 批量导入导出, 文件浏览, 大量API端点, 文件大小检查."
    },
    {
      "agent": "audit-spec-infra",
      "blocking": false,
      "priority": "low",
      "reason": "CodeSwarm Worker Docker部署, Redis Stream架构, NFS文件存储, 跨服务信任边界, 环境变量配置."
    }
  ],
  "dimension_owners": {
    "D1": "audit-spec-injection",
    "D2": "audit-spec-auth-access",
    "D3": "audit-spec-auth-access"
  },

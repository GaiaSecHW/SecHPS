# .dockerignore for SecHPS Server
# Build context: project root (docker build -f Dockerfile.server .)
#
# Note: CodeSwarm Worker uses codeswarm/.dockerignore (separate context)

# === Rebuilt in Docker (not needed in build context) ===
.next
node_modules

# === Separate Docker image (worker has its own build) ===
codeswarm/

# === Version control ===
.git
.gitignore

# === IDE ===
.idea
.vscode
*.swp
.claude/
.omc/

# === Secrets (must never be in image) ===
.env
.env.local
.env.example

# === Runtime data (mounted as volumes at deploy time) ===
data/
uploads/
skill_management/
AgentHarness/
skills.clone/
test-skills-output/

# === Logs ===
*.log
app.log
worker.log

# === Scripts (only postbuild.js needed for build, rest excluded) ===
scripts/*
!scripts/postbuild.js

# === Dev/test artifacts ===
docs/
test-*.js
test-*.ts
test-*.py
test-*.cjs
test-*.mjs
test-project/
test-results/
test-outputs/

# === Misc ===
/*.md
*.zip
*.tar.gz
*.7z
*.db
dev.db
prod_dev.db
tsconfig.tsbuildinfo
temp-*
session-ses_*.md
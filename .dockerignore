# .dockerignore for CodeSwarm Service
# Build context: project root
#   docker build -f docker/Dockerfile.scheduler .
#   docker build -f docker/Dockerfile.worker .

# === Rebuilt in Docker (not needed in build context) ===
node_modules
**/dist

# === Version control ===
.git
.gitignore
.gitattributes
.gitmodules

# === IDE / Claude tools ===
.idea
.vscode
*.swp
.claude/
.omc/
.codegraph/
.opencode/

# === Secrets (must never be in image) ===
.env
.env.local
.env.example

# === Logs ===
*.log

# === Dev/test artifacts ===
.github/
k8s/
*.md
tsconfig.tsbuildinfo

# ============================================================================
# CodeSwarm Worker 环境变量配置
# ============================================================================
# 此文件是 Worker 独立部署时使用的配置模板。
# 开发模式下，Worker 读取 codeswarm/.env（此文件的副本）。
# 生产 Docker 部署时，环境变量通过 docker-compose.yml 的 environment 字段注入。
# ============================================================================

# ---- Worker 核心配置 ----
NODE_ID=worker-01                          # Worker 节点唯一标识（默认随机生成）
PORT=8090                                  # HTTP 监听端口（避免与 VS Code 8080 冲突）
MAX_CONCURRENT=5                           # 最大并发任务数
ORCHESTRATOR_URL=http://localhost:3000     # 主服务器回调地址（Worker 网络需能访问）
WORKER_ADDRESS=                            # Worker 外部可达地址（心跳上报时使用，默认为空）

# ---- CodeMap 知识图谱引擎 ----
CODEDMAP_HOME=/opt/codedmap                # CodeMap 安装路径（Linux 生产默认 /opt/codedmap）
                                           # Windows 开发默认: ./plugins/codedmap
JOERN_HOME=/opt/joern/joern-cli            # Joern CLI 安装路径
JAVA_HOME=/usr/lib/jvm/java-19-openjdk     # Java 运行时路径（Joern 依赖）

# ---- MinIO 对象存储 ----
# Worker 用于 CodeMap 知识图谱 DB 文件的缓存存储
# 注意：主服务器也使用同一个 MinIO 实例（但用于漏洞文件存储）
MINIO_ENDPOINT=172.31.23.181
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=codedmap-dbs                  # CodeMap DB 缓存桶名
MINIO_USE_SSL=false
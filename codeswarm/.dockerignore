# .dockerignore for codeswarm worker
# Build context: codeswarm/ directory (docker build -f Dockerfile -t codeswarm-worker:latest .)

# === Build artifacts (rebuilt in Docker) ===
node_modules
packages/*/dist
packages/*/data/task_workspaces

# === Runtime state ===
**/.claude
**/.omc

# === Environment & secrets ===
.env
.env.local
.env.example

# === Logs ===
*.log
worker.log

# === IDE ===
.idea
.vscode
*.swp

# === Misc (not needed in image) ===
ARCHITECTURE.md
CodeSwarm.md
instruction.txt
test_api.py
test-project/
docker-compose.yml
shared/
package-lock.json

# === Codedmap runtime state ===
plugins/codedmap/.audit_state
plugins/codedmap/audit.db
plugins/codedmap/ignored.db
plugins/codedmap/**/__pycache__
plugins/codedmap/codedmap.egg-info
plugins/codedmap/uv.lock

# === Cache & build artifacts ===
**/__pycache__
**/*.pyc
**/*.pyo
**/*.egg-info
.cache/
coverage/
.nyc_output/
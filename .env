# Environment variables
DATABASE_URL="postgresql://postgres:Huawei12%23%24@172.31.23.182:5432/ai4sec?connection_limit=10&pool_timeout=30&connect_timeout=10"
JWT_SECRET="your-secret-key-change-in-production"
NODE_ENV="development"

# SFTP 配置 - 任务实例上传文件到远程服务器
SFTP_HOST="172.31.30.81"
SFTP_PORT="22"
SFTP_USER="icsl"
SFTP_PASSWORD="Huawei12#$"
SFTP_REMOTE_PATH="/home/icsl/Shared-workspace"

# 路径映射 - Windows 本地调试时映射远程路径到本地
# 格式: "远程路径=本地路径"
# 示例: "/home/icsl/Shared-workspace=Z:"
# 如果配置了此变量，worker 会自动将远程路径转换为本地路径
PATH_MAPPING="/home/icsl=P:"

# Claude SDK MCP 超时配置（毫秒）- 10 分钟
CLAUDE_CODE_STREAM_CLOSE_TIMEOUT=600000

# Gitea 配置 - AgentHarness 文件存储
GITEA_URL="http://localhost:3001"  # Gitea 服务地址
GITEA_TOKEN="398809ab01144a7ea5d59514fe6bd338007bbc29"  # Gitea API Token (需要 repo write 权限)
GITEA_REPO_OWNER="admin"  # 仓库所有者
GITEA_REPO_NAME="test"  # 仓库名称
GITEA_BRANCH="main"  # 分支名称
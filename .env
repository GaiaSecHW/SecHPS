# SFTP 配置 - 任务实例上传文件到远程服务器
SFTP_HOST="172.31.30.81"
SFTP_PORT="22"
SFTP_USER="icsl"
SFTP_PASSWORD="Huawei12#$"
SFTP_REMOTE_PATH="/home/icsl/Shared-workspace"

# 路径映射 - Windows 本地调试时映射远程路径到本地
# 格式: "远程路径=本地路径"
# 示例: "/home/icsl/Shared-workspace=Z:"
# 如果配置了此变量，worker 会自动将远程路径转换为本地路径
PATH_MAPPING="/home/icsl=P:"

# Claude SDK MCP 超时配置（毫秒）- 10 分钟
CLAUDE_CODE_STREAM_CLOSE_TIMEOUT=600000

# Gitea 配置 - AgentHarness 文件存储（Git 同步）

{
  "name": "codeswarm-service",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:scheduler": "pnpm --filter @codeswarm/scheduler dev",
    "dev:worker": "pnpm --filter @codeswarm/worker dev",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
